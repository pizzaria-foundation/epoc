//  The registration resource, shared by every service. GENERATED from this template by
//  tools/symbuild into <app>/build/<name>.rss — do not edit the generated file.
//
//  Shared because every per-service value in it is already a substituted variable: the two
//  UIDs, the human-readable name, and the DLL's filename. A service points MTM_RESOURCE_TEMPLATE
//  at this path and writes none of it.
//
//  The @ORD_*@ placeholders are filled from the .def elf2e32 wrote, so each entry_point is
//  the ordinal the linker actually assigned rather than the one somebody assumed. elf2e32
//  numbers exports by sorting their names, so declaration order in app.conf says nothing.
//
//  All four component slots are declared, and all four are implemented by shim/mtm.
//  CObserverRegistry::HandleSessionEventL indexes the declared array by fixed slot — 0
//  server, 1 client, 2 UI, 3 UI data — with no bounds check, so a registration that declares
//  fewer components makes the Message Server's own client read past the end of the array.
//  That is a panic, not a Leave, and it kills whichever process installed the group.

#include <mtmconfig.rh>

RESOURCE MTM_INFO_FILE
    {
    mtm_type_uid = @MTM_TYPE_UID@;
    technology_type_uid = @MTM_TECHNOLOGY_UID@;
    components =
        {
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmServerComponentVal;
            entry_point = @ORD_SERVER@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmClientComponentVal;
            entry_point = @ORD_CLIENT@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmUiComponentVal;
            entry_point = @ORD_UI@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmUiDataComponentVal;
            entry_point = @ORD_UIDATA@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            }
        };
    }

//  send_capability = 1, because this MTM does produce outgoing messages: the UI component's
//  ReplyL writes one into the store for a daemon to carry out.
//
//  This was 0, alongside a CanReplyToEntryL of ETrue, and the two could not both be right. The
//  reply item did not appear in the Messaging application's menu, and this contradiction is the
//  first candidate — which of the three places this MTM declares "can send" MCE actually reads
//  is measured by the breadcrumbs in src/mtmuidata.cpp, not assumed here.
//
//  The narrower question of whether other applications should offer this MTM in "Send via…" is
//  answered EFalse, separately, through KUidMtmQuerySendAsMessageSendSupportValue.
RESOURCE MTM_CAPABILITIES
    {
    send_capability = 1;
    body_capability = 1;
    }

//  Must exist, must be third, may be empty.
RESOURCE MTM_SECURITY_CAPABILITY_SET
    {
    }
