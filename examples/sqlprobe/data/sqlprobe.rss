/* The localisable resource: the caption and icon the S60 menu shows. */

NAME SQLP

#include <eikon.rh>
#include <appinfo.rh>

RESOURCE RSS_SIGNATURE { }
RESOURCE TBUF { buf = ""; }

/* Empty on purpose: the AppUi is constructed with ENoScreenFurniture, so Avkon has no
 * menu bar or CBA to populate — the softkey bar is drawn by the Rust toolkit. The
 * resource is still required for Avkon to finish initialising. */
RESOURCE EIK_APP_INFO { }

RESOURCE LOCALISABLE_APP_INFO r_sqlprobe_localisable_app_info
    {
    short_caption = "Sqlprobe";
    caption_and_icon =
        CAPTION_AND_ICON_INFO
            {
            caption = "Sqlprobe";
            number_of_icons = 0;
            };
    }
