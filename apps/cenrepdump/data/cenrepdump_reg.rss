/* Application registration. Installed into \private\10003a3f\import\apps\ — that
 * exact path is what makes the app appear in the S60 menu.
 *
 * 10003a3f is AppArc's own SID, not ours, and `import` is its writable drop-box.
 * Installing to \private\10003a3f\apps\ instead works on the emulator and fails
 * silently on a device: the classic "installs fine but never shows up" bug. */

#include <appinfo.rh>
#include "cenrepdump.rsg"

UID2 KUidAppRegistrationResourceFile
UID3 0xE0AA0020

RESOURCE APP_REGISTRATION_INFO
    {
    app_file = "cenrepdump";
    localisable_resource_file = "\\resource\\apps\\cenrepdump";
    localisable_resource_id = R_CENREPDUMP_LOCALISABLE_APP_INFO;
    hidden = KAppNotHidden;
    embeddability = KAppNotEmbeddable;
    newfile = KAppDoesNotSupportNewFile;
    launch = KAppLaunchInForeground;
    }
