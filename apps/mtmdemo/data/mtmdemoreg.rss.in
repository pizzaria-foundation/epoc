    technology_type_uid = @MTM_TECHNOLOGY_UID@;
    components =
        {
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmServerComponentVal;
            entry_point = @ORD_SERVER@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmClientComponentVal;
            entry_point = @ORD_CLIENT@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmUiComponentVal;
            entry_point = @ORD_UI@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            },
        MTM_COMPONENT_V2
            {
            human_readable_name = "@MTM_NAME@";
            component_uid = KUidMtmUiDataComponentVal;
            entry_point = @ORD_UIDATA@;
            version = VERSION_V2 {};
            filename = "@DLL@";
            }
        };
    }

//  SendAs. This MTM cannot send — there is no server component behind the slot — so it
//  advertises nothing rather than appearing in "Send via…" with nothing behind it.
RESOURCE MTM_CAPABILITIES
    {
    send_capability = 0;
    body_capability = 1;
    }

