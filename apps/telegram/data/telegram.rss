/* The localisable resource: the caption and icon the S60 menu shows.
 *
 * Paired with telegram_reg.rss, which points at this file and at
 * R_TELEGRAM_LOCALISABLE_APP_INFO. The registration says where to look; this says
 * what to show.
 */

NAME TGRM

#include <eikon.rh>
#include <appinfo.rh>

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF { buf = ""; }

/* Empty on purpose. The AppUi is constructed with ENoScreenFurniture, so Avkon
 * has no menu bar and no CBA to populate — the softkey bar is drawn by the Rust
 * toolkit, which is what lets it look like something other than stock Avkon. The
 * resource itself is still required for Avkon to finish initialising. */
RESOURCE EIK_APP_INFO
    {
    }

RESOURCE LOCALISABLE_APP_INFO r_telegram_localisable_app_info
    {
    /* Shown where the full caption does not fit — the E72's grid is one of those
     * places, so this is the string most users actually see. */
    short_caption = "Telegram";

    caption_and_icon =
        CAPTION_AND_ICON_INFO
            {
            caption = "Telegram";
            number_of_icons = 1;
            icon_file = "\\resource\\apps\\telegram_icon.mbm";
            };
    }
