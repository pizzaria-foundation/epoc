/* Application registration. Compiled to telegram_reg.rsc and installed into
 * \private\10003a3f\import\apps\ — that exact path is what makes the app appear
 * in the S60 menu.
 *
 * 10003a3f is AppArc's own SID, not ours, and `import` is its writable drop-box.
 * Installing to \private\10003a3f\apps\ instead works on the emulator and fails
 * silently on a device: the classic "installs fine but never shows up" bug.
 */

#include <appinfo.rh>
#include "telegram.rsg"

/* UID2 marks the file as a registration resource. UID3 is the application, and
 * must match app.conf's UID3 — which symbuild also feeds to elf2e32 and to the
 * shim's KUidShimApp. */
UID2 KUidAppRegistrationResourceFile
UID3 0xE1234569

RESOURCE APP_REGISTRATION_INFO
    {
    /* Basename of the executable: no path, no extension. */
    app_file = "telegram";

    /* Path only, no drive letter — the installer substitutes whichever drive the
     * app landed on. */
    localisable_resource_file = "\\resource\\apps\\telegram";
    localisable_resource_id = R_TELEGRAM_LOCALISABLE_APP_INFO;

    hidden = KAppNotHidden;
    embeddability = KAppNotEmbeddable;
    newfile = KAppDoesNotSupportNewFile;
    launch = KAppLaunchInForeground;
    }
