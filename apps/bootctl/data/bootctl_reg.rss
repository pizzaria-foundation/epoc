//  bootctl registration resource. Without this the package installs, reports success, and the
//  application is simply not in the menu.
#include <appinfo.rh>
#include <bootctl.rsg>

UID2 KUidAppRegistrationResourceFile
UID3 0xE0AA0010

RESOURCE APP_REGISTRATION_INFO
    {
    app_file = "bootctl";
    localisable_resource_file = "\\resource\\apps\\bootctl";
    localisable_resource_id = R_BOOTCTL_LOCALISABLE_APP_INFO;
    }
