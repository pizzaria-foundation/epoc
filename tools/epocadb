#!/usr/bin/env python3
"""epocadb — dev bridge for Symbian.

   serve   Listen for device connections, forward commands from the CLI
   devices Listen for UDP beacons and show discovered devices
   push    Queue a file push to the device
   pull    Queue a file pull from the device
   install Queue a .sis transfer to the device
   logcat  Stream log lines from the device

The device connects out to the host (reverse-client model).  The host listens;
the device reaches it over Wi-Fi.

Nothing in the serve loop blocks on the device.  Every read is buffered and
resumable, every operation carries a deadline, and a device that stops talking
mid-transfer leaves the session idle rather than wedged -- which is what the
first version did, and what made a broken bridge indistinguishable from a
broken program under test.
"""

import argparse
import queue
import selectors
import socket
import sys
import threading
import time
from pathlib import Path

CMD_PORT = 9091
LOG_PORT = 9092
BEACON_PORT = 9093
CONTROL_PORT = CMD_PORT + 1000

# How long an operation may sit unfinished before it is abandoned.
OP_TIMEOUT = 60.0
# How long a device may be unheard from in `devices` before it is dropped.
DEVICE_TTL = 30.0
# Where `install` puts a .sis by default: a public path any build can write, from
# which the user opens it in File Manager. The platform's own import directory
# needs capabilities this bridge does not have -- see docs/spec-epocadb.md.
DEFAULT_INSTALL_DIR = "C:\\Data"


# ── buffered, resumable reading ───────────────────────────────────

class PeerClosed(Exception):
    """The far end closed the connection."""


class LineReader:
    """A non-blocking buffered reader over one socket.

    Two properties the first version lacked and needed:

    * It keeps its partial buffer. The old reader read one byte at a time and
      returned None on timeout, throwing away everything it had accumulated --
      so a line split across a poll boundary lost its front half and every
      later line was misparsed.
    * Payload bytes and line bytes come out of the same buffer. A `DATA n`
      header and the bytes it describes arrive in the same segment, so reading
      the payload straight from the socket strands whatever was already read.
    """

    def __init__(self, sock: socket.socket):
        self.sock = sock
        self.sock.setblocking(False)
        self.buf = bytearray()

    def pump(self) -> None:
        """Take whatever has arrived. Raises PeerClosed at end of stream."""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except BlockingIOError:
                return
            except (socket.timeout, TimeoutError):
                return
            except OSError:
                raise PeerClosed
            if not chunk:
                raise PeerClosed
            self.buf += chunk
            if len(chunk) < 65536:
                return

    def take_line(self) -> str | None:
        """One complete line, or None. Accepts LF and CRLF.

        The device's log channel separates lines with LF alone -- the ring
        buffer appends one byte -- while the command channel uses CRLF. A reader
        that insists on CRLF sees the log as one line that never ends.
        """
        i = self.buf.find(b"\n")
        if i < 0:
            return None
        line = bytes(self.buf[:i])
        del self.buf[: i + 1]
        return line.rstrip(b"\r").decode("utf-8", errors="replace")

    def take_exactly(self, n: int) -> bytes | None:
        """`n` buffered bytes, or None if they have not all arrived."""
        if len(self.buf) < n:
            return None
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out

    def buffered(self) -> int:
        return len(self.buf)


def send_line(sock: socket.socket, line: str) -> None:
    sock.sendall((line + "\r\n").encode())


# ── the CLI control channel ───────────────────────────────────────

class ServerState:
    def __init__(self):
        self.cmd_queue: queue.Queue[str] = queue.Queue()
        self.running = True


def _control_thread(state: ServerState) -> None:
    """Accept one-line commands from other epocadb invocations."""
    ctl = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    ctl.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        ctl.bind(("127.0.0.1", CONTROL_PORT))
    except OSError as e:
        print(f"epocadb: cannot bind control port {CONTROL_PORT}: {e}", file=sys.stderr)
        return
    ctl.listen(5)
    ctl.settimeout(0.5)
    while state.running:
        try:
            conn, _addr = ctl.accept()
        except (socket.timeout, TimeoutError):
            continue
        except OSError:
            break
        try:
            conn.settimeout(2.0)
            data = b""
            while b"\n" not in data and len(data) < 4096:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            line = data.split(b"\n", 1)[0].rstrip(b"\r").decode("utf-8", errors="replace")
            if line:
                state.cmd_queue.put(line)
                conn.sendall(b"OK queued\r\n")
        except OSError:
            pass
        finally:
            conn.close()
    ctl.close()


# ── serve ─────────────────────────────────────────────────────────

IDLE = "idle"
AWAIT_WRITE_ACK = "await-write-ack"
AWAIT_PULL_SIZE = "await-pull-size"
AWAIT_PULL_DATA = "await-pull-data"


class Session:
    """One device connection, driven entirely by what has already arrived."""

    def __init__(self, cmd_conn: socket.socket, log_conn: socket.socket):
        self.cmd_conn = cmd_conn
        self.cmd = LineReader(cmd_conn)
        self.log = LineReader(log_conn)
        self.state = IDLE
        self.deadline = 0.0
        self.pull_local: Path | None = None
        self.pull_size = 0

    def begin(self, state: str) -> None:
        self.state = state
        self.deadline = time.monotonic() + OP_TIMEOUT

    def idle(self) -> None:
        self.state = IDLE
        self.deadline = 0.0
        self.pull_local = None
        self.pull_size = 0

    def check_deadline(self) -> None:
        if self.state != IDLE and time.monotonic() > self.deadline:
            print(f"  [!] {self.state} timed out after {OP_TIMEOUT:.0f}s — abandoning")
            self.idle()

    # -- handling one line from the device --

    def on_cmd_line(self, line: str, pending: list[str]) -> None:
        if line == "REQ PING":
            self.on_ping(pending)
        elif self.state == AWAIT_WRITE_ACK:
            print(f"  <-- {line}")
            self.idle()
        elif self.state == AWAIT_PULL_SIZE:
            self.on_pull_size(line)
        elif self.state == AWAIT_PULL_DATA:
            self.on_pull_data_header(line)
        else:
            print(f"  <-- {line}")

    def on_ping(self, pending: list[str]) -> None:
        if self.state != IDLE or not pending:
            send_line(self.cmd_conn, "OK pong")
            return
        raw = pending.pop(0)
        try:
            self.dispatch(raw)
        except Exception as e:  # noqa: BLE001 — a bad CLI line must not kill the server
            print(f"  [!] bad command {raw!r}: {e}")
            send_line(self.cmd_conn, "OK pong")
            self.idle()

    def dispatch(self, raw: str) -> None:
        verb, rest = (raw.split(" ", 1) + [""])[:2]

        if verb == "CTL":
            # Application-defined control: the device defines the verbs, interprets the
            # line and answers on the log channel, so there is nothing to wait for here —
            # send the reply and return to idle.
            send_line(self.cmd_conn, f"OK CTL {rest}")
            print(f"  --> CTL {rest}")
            self.idle()
            return

        if verb == "QUIT":
            # Ask the device app to exit. Nothing to wait for; the connection simply drops
            # when the app goes.
            send_line(self.cmd_conn, "OK QUIT")
            print("  --> QUIT")
            self.idle()
            return

        if verb == "PULL":
            remote, local = rest.rsplit("\t", 1)
            self.pull_local = Path(local)
            send_line(self.cmd_conn, f"OK PULL {remote}")
            print(f"  --> PULL {remote}")
            self.begin(AWAIT_PULL_SIZE)
            return

        if verb in ("PUSH", "INSTALL"):
            local, remote = rest.rsplit("\t", 1)
            data = Path(local).read_bytes()
            send_line(self.cmd_conn, f"OK {verb} {remote} {len(data)}")
            print(f"  --> {verb} {remote} ({len(data)} bytes)")
            # The device is now waiting for the payload; header and bytes go out
            # back to back so they land in the same segment where possible.
            self.cmd_conn.sendall(f"DATA {len(data)}\r\n".encode() + data)
            self.begin(AWAIT_WRITE_ACK)
            if verb == "INSTALL":
                print(f"      once written, open {remote} on the device to install it")
            return

        print(f"  [!] unknown queued command: {raw!r}")
        send_line(self.cmd_conn, "OK pong")

    def on_pull_size(self, line: str) -> None:
        if not line.startswith("OK "):
            print(f"  [pull] device refused: {line}")
            self.idle()
            return
        size_text = line[3:].strip()
        if not size_text.isdigit():
            print(f"  [pull] unparseable size: {line!r}")
            self.idle()
            return
        self.pull_size = int(size_text)
        print(f"  [pull] {self.pull_size} bytes incoming")
        self.begin(AWAIT_PULL_DATA)

    def on_pull_data_header(self, line: str) -> None:
        if not line.startswith("DATA "):
            print(f"  [pull] expected DATA, got {line!r}")
            self.idle()
            return
        count = line[5:].strip()
        if not count.isdigit():
            print(f"  [pull] unparseable DATA header: {line!r}")
            self.idle()
            return
        self.pull_size = int(count)
        # The payload is read from the same buffer the header came out of.
        self.state = "await-pull-body"

    def try_finish_pull(self) -> None:
        if self.state != "await-pull-body":
            return
        data = self.cmd.take_exactly(self.pull_size)
        if data is None:
            return
        assert self.pull_local is not None
        self.pull_local.parent.mkdir(parents=True, exist_ok=True)
        self.pull_local.write_bytes(data)
        print(f"  [pull] saved {len(data)} bytes → {self.pull_local}")
        self.idle()


# ── log rendering ─────────────────────────────────────────────────

# An app's log lines carry a leading [tag] by convention (`symbian::log!("[net] …")`);
# colour the ones the SDK itself emits so a busy stream is scannable. An unknown tag is not
# an error — it is somebody's own category, printed plain.
_TAG_COLOR = {
    "log": "\033[32m",       # green  — an app's own lines
    "net": "\033[1;33m",     # bold yellow — sockets, bearers, the wire
    "ui": "\033[36m",        # cyan   — screens and input
    "mem": "\033[34m",       # blue   — memory readings
    "gfx": "\033[1;36m",     # bold cyan — present efficiency
    "step": "\033[1;35m",    # bold magenta — rust_step watchdog (GUI-thread stalls)
    "recv": "\033[1;33m",    # bold yellow — receive-path breakdown (decrypt vs parse)
}
_RESET = "\033[0m"


def render_log(line: str) -> str:
    """Render a device log line, colouring by its leading [tag] on a tty.

    A line that carries a tag (``[net] …``) is coloured by it; one without is printed as-is
    under a neutral marker.
    """
    tag = None
    if line.startswith("[") and "]" in line:
        tag = line[1 : line.index("]")].split(":", 1)[0]
    if tag and tag in _TAG_COLOR and sys.stdout.isatty():
        return f"  {_TAG_COLOR[tag]}{line}{_RESET}"
    return f"  {line}"


def cmd_serve(args) -> None:
    state = ServerState()
    threading.Thread(target=_control_thread, args=(state,), daemon=True).start()

    listeners = []
    try:
        for port, label in ((CMD_PORT, "cmd"), (LOG_PORT, "log")):
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("0.0.0.0", port))
            s.listen(1)
            s.settimeout(1.0)
            listeners.append((s, label))
    except OSError as e:
        print(f"epocadb serve: cannot listen: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"epocadb serve  listening on tcp:{CMD_PORT} (cmd)  tcp:{LOG_PORT} (log)")
    print("              waiting for device...  (ctrl-c to stop)\n")

    conns = {}
    try:
        for s, label in listeners:
            while True:
                try:
                    conn, addr = s.accept()
                    break
                except (socket.timeout, TimeoutError):
                    continue
            conns[label] = conn
            print(f"{label}  connected from {addr[0]}:{addr[1]}")
    except KeyboardInterrupt:
        print("\nepocadb serve  stopped before a device arrived")
        for c in conns.values():
            c.close()
        for s, _ in listeners:
            s.close()
        return

    print()
    session = Session(conns["cmd"], conns["log"])
    pending: list[str] = []

    sel = selectors.DefaultSelector()
    sel.register(conns["cmd"], selectors.EVENT_READ, "cmd")
    sel.register(conns["log"], selectors.EVENT_READ, "log")

    try:
        while state.running:
            while True:
                try:
                    pending.append(state.cmd_queue.get_nowait())
                    print(f"  [cmd] queued: {pending[-1]}")
                except queue.Empty:
                    break

            for key, _mask in sel.select(timeout=0.2):
                reader = session.cmd if key.data == "cmd" else session.log
                reader.pump()

            while (line := session.cmd.take_line()) is not None:
                session.on_cmd_line(line, pending)
                if session.state == "await-pull-body":
                    break
            session.try_finish_pull()

            while (line := session.log.take_line()) is not None:
                print(render_log(line))

            session.check_deadline()
    except PeerClosed:
        print("\n  device disconnected")
    except KeyboardInterrupt:
        print()
    finally:
        state.running = False
        sel.close()
        for c in conns.values():
            c.close()
        for s, _ in listeners:
            s.close()
    print("epocadb serve  stopped")


# ── devices ───────────────────────────────────────────────────────

def cmd_devices(args) -> None:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    except OSError:
        pass
    try:
        sock.bind(("0.0.0.0", BEACON_PORT))
    except OSError as e:
        print(f"epocadb devices: cannot bind udp:{BEACON_PORT}: {e}", file=sys.stderr)
        sys.exit(1)
    sock.settimeout(1.0)

    print(f"epocadb devices  listening on udp:{BEACON_PORT}  (ctrl-c to stop)\n")

    seen: dict[str, tuple[str, str, float]] = {}
    drawn = 0

    def render() -> None:
        nonlocal drawn
        for _ in range(drawn):
            sys.stdout.write("\033[F\033[K")
        header = f"{'Device':<30} {'Address':<18} {'Last seen'}"
        print(header)
        print("-" * len(header))
        rows = sorted(seen.values(), key=lambda r: -r[2])
        for label, ip, at in rows:
            ago = time.monotonic() - at
            print(f"{label:<30} {ip:<18} {ago:.0f}s ago")
        drawn = len(rows) + 2

    render()
    try:
        while True:
            try:
                data, addr = sock.recvfrom(1024)
                text = data.decode("utf-8", errors="replace").strip()
                seen[addr[0]] = (text or "(empty beacon)", addr[0], time.monotonic())
            except (socket.timeout, TimeoutError):
                pass
            # A device that has gone quiet is not a device you can push to.
            now = time.monotonic()
            for ip in [ip for ip, r in seen.items() if now - r[2] > DEVICE_TTL]:
                del seen[ip]
            render()
    except KeyboardInterrupt:
        pass
    finally:
        sock.close()

    print(f"\nepocadb devices  {len(seen)} device(s) seen")


# ── CLI control ───────────────────────────────────────────────────

def _send_control(line: str) -> None:
    try:
        with socket.create_connection(("127.0.0.1", CONTROL_PORT), timeout=2.0) as s:
            s.sendall((line + "\r\n").encode())
            print(s.recv(1024).decode(errors="replace").strip())
    except (ConnectionRefusedError, socket.timeout, TimeoutError, OSError):
        print("epocadb: no serve process running. Start with 'epocadb serve' first.", file=sys.stderr)
        sys.exit(1)


def _must_exist(path: str, what: str) -> Path:
    p = Path(path)
    if not p.exists():
        print(f"epocadb {what}: {p}: file not found", file=sys.stderr)
        sys.exit(1)
    return p


def cmd_push(args) -> None:
    src = _must_exist(args.local, "push")
    # Tab-separated: a Symbian path is full of backslashes and may contain spaces,
    # so a space is not a separator anyone can rely on.
    _send_control(f"PUSH {src}\t{args.remote}")


def cmd_pull(args) -> None:
    _send_control(f"PULL {args.remote}\t{args.local}")


def cmd_install(args) -> None:
    sis = _must_exist(args.sis, "install")
    remote = args.remote or f"{DEFAULT_INSTALL_DIR}\\{sis.name}"
    _send_control(f"INSTALL {sis}\t{remote}")


def cmd_quit(args) -> None:
    # Ask the connected device app to exit cleanly — useful when Wi-Fi is up but the phone
    # is out of reach.
    _send_control("QUIT")


def cmd_logcat(args) -> None:
    print(f"epocadb logcat  listening on tcp:{LOG_PORT}  (ctrl-c to stop)")
    print("              note: cannot run while 'epocadb serve' holds the port\n")
    log_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    log_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        log_sock.bind(("0.0.0.0", LOG_PORT))
    except OSError as e:
        print(f"epocadb logcat: cannot bind tcp:{LOG_PORT}: {e}", file=sys.stderr)
        sys.exit(1)
    log_sock.listen(1)
    log_sock.settimeout(1.0)

    conn = None
    try:
        while conn is None:
            try:
                conn, addr = log_sock.accept()
            except (socket.timeout, TimeoutError):
                continue
        print(f"log  connected from {addr[0]}:{addr[1]}\n")
        reader = LineReader(conn)
        sel = selectors.DefaultSelector()
        sel.register(conn, selectors.EVENT_READ)
        while True:
            for _key, _mask in sel.select(timeout=0.5):
                reader.pump()
            while (line := reader.take_line()) is not None:
                print(render_log(line).lstrip())
    except PeerClosed:
        print("\n  device disconnected")
    except KeyboardInterrupt:
        print()
    finally:
        if conn is not None:
            conn.close()
        log_sock.close()
    print("epocadb logcat  stopped")


# ── main ──────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(description="epocadb — dev bridge for Symbian")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("serve", help="listen for device connections").set_defaults(func=cmd_serve)
    sub.add_parser("devices", help="listen for device beacons").set_defaults(func=cmd_devices)
    sub.add_parser("logcat", help="stream device logs").set_defaults(func=cmd_logcat)

    sub.add_parser("quit", help="ask the connected device app to exit").set_defaults(func=cmd_quit)

    p_push = sub.add_parser("push", help="push a file to the device")
    p_push.add_argument("local", help="local file path")
    p_push.add_argument("remote", help="remote path on the device, e.g. C:\\Data\\file.bin")
    p_push.set_defaults(func=cmd_push)

    p_pull = sub.add_parser("pull", help="pull a file from the device")
    p_pull.add_argument("remote", help="remote path on the device")
    p_pull.add_argument("local", help="where to write it locally")
    p_pull.set_defaults(func=cmd_pull)

    p_install = sub.add_parser("install", help="send a .sis to the device for manual install")
    p_install.add_argument("sis", help="path to the .sis file")
    p_install.add_argument("--remote", help=f"remote path (default {DEFAULT_INSTALL_DIR}\\<name>)")
    p_install.set_defaults(func=cmd_install)

    args = parser.parse_args()
    if args.command is None:
        cmd_serve(args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
