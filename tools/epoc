#!/bin/bash
# epoc — the one entry point.
#
#   epoc new <name> [uid3]        scaffold a project that builds and runs
#   epoc build <app-dir> [clean]  sources → installable .sis
#   epoc preview                  render the SDK's contact sheets to preview-out/
#   epoc sideload <file…>         put packages in C:\Data\_app_install, ready to tap
#   epoc serve                    serve out/ over the LAN so the phone can fetch a .sis
#   epoc rshell [device] [chan]   drive the RFCOMM remote shell on the phone
#   epoc sh <args…>               one-shot rshell: 'ls C:\Data', --pull, --push, --sideload
#   epoc logs [app] [-f]          print C:\Data\_logs\<app>.txt from the phone; -f follows it
#
# Why a dispatcher rather than a rewrite: `symnew` and `symbuild` are working tools that are
# not improved by being merged, and the phone-side verbs belong to ADBian, a separate project. What was wrong was the *surface* — three names to remember, none of them the
# project's. They still work when called directly; this is the front door, not a replacement.
#
# EPOC is what this operating system was called before it was called Symbian, which is the
# joke and also the reason the name was available.
set -euo pipefail

SDK="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# ADBian is a sibling checkout, not part of this SDK: it is the remote shell, and the three
# verbs below are the SDK's front door to it. Say so plainly when it is not there, rather than
# letting python report a missing file.
adbian() {
  local script="$SDK/../ADBian/client/$1"; shift
  [ -f "$script" ] || {
    echo "epoc: needs the ADBian checkout beside this one:" >&2
    echo "  git clone git@github.com:pizzaria-foundation/ADBian.git $SDK/../ADBian" >&2
    exit 1
  }
  exec python3 "$script" "$@"
}

CMD="${1:-}"
[ $# -gt 0 ] && shift || true

case "$CMD" in
  new)      exec "$SDK/tools/symnew" "$@" ;;
  build)    exec "$SDK/tools/symbuild" "$@" ;;
  preview)  exec cargo run -q -p preview "$@" ;;
  serve)    exec python3 "$SDK/tools/serve.py" "$@" ;;
  rshell)   adbian rshell.py "$@" ;;
  sh)       adbian rsh.py "$@" ;;
  sideload) adbian rsh.py --sideload "$@" ;;
  # The log, which is a file on the phone and nothing more: `symbian::log!` appends to
  # C:\Data\_logs\<app>.txt and this reads it back. `-f` polls and prints what is new, which is
  # as close to `adb logcat` as a 2009 phone over Bluetooth gets — and unlike the TCP bridge it
  # replaced, it needs no Wi-Fi, no per-app feature and nothing linked into the app.
  logs)     adbian rsh.py --logs "$@" ;;
  pull)     adbian rsh.py --pull "$@" ;;
  ""|-h|--help|help) usage 0 ;;
  *)
    echo "epoc: unknown command '$CMD'" >&2
    usage 1
    ;;
esac
