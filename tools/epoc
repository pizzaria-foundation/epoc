#!/bin/bash
# epoc — the one entry point.
#
#   epoc new <name> [uid3]        scaffold a project that builds and runs
#   epoc build <app-dir> [clean]  sources → installable .sis
#   epoc db <args…>               the dev bridge: serve, logcat, push, pull, install
#   epoc preview                  render the SDK's contact sheets to preview-out/
#   epoc push <file>              send a file to the phone over Bluetooth
#   epoc serve                    serve out/ over the LAN so the phone can fetch a .sis
#
# Why a dispatcher rather than a rewrite: `symnew`, `symbuild` and `epocadb` are three
# languages' worth of working tool (bash, bash, Python) and none of them is improved by being
# merged. What was wrong was the *surface* — three names to remember, none of them the
# project's. They still work when called directly; this is the front door, not a replacement.
#
# EPOC is what this operating system was called before it was called Symbian, which is the
# joke and also the reason the name was available.
set -euo pipefail

SDK="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

CMD="${1:-}"
[ $# -gt 0 ] && shift || true

case "$CMD" in
  new)      exec "$SDK/tools/symnew" "$@" ;;
  build)    exec "$SDK/tools/symbuild" "$@" ;;
  db)       exec "$SDK/tools/epocadb" "$@" ;;
  preview)  exec cargo run -q -p preview "$@" ;;
  push)     exec python3 "$SDK/tools/btpush.py" "$@" ;;
  serve)    exec python3 "$SDK/tools/serve.py" "$@" ;;
  # Handy shorthands for the two db subcommands anyone types twenty times a day.
  logcat)   exec "$SDK/tools/epocadb" logcat "$@" ;;
  pull)     exec "$SDK/tools/epocadb" pull "$@" ;;
  ""|-h|--help|help) usage 0 ;;
  *)
    echo "epoc: unknown command '$CMD'" >&2
    usage 1
    ;;
esac
