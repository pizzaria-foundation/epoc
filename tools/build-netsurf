#!/bin/bash
# build-netsurf — cross-compile the five vendored NetSurf MIT libraries for armv5.
#
# Called by tools/symbuild when an app.conf sets USE_NETSURF=1, and re-runnable by
# hand. It is a plain compile-every-.c-into-one-archive-per-library script and
# deliberately not the NetSurf buildsystem: that one wants make, perl, pkg-config
# and a Makefile.config per library, and every question it answers we have already
# answered here (one target, one ABI, no shared objects, no tests).
#
# Output: vendor/netsurf-symbian/build/armv5/lib<name>.a, plus a .stamp per
# library. Incremental by mtime — an object older than its source is rebuilt, and
# nothing else is. A full build is ~445 translation units, so an app that opts in
# pays that once and then pays nothing.
#
# Two things upstream generates at build time and this script does NOT: the perl
# and gperf and host-C generators. Their output is vendored (see the README), so
# neither perl nor gperf nor a host compiler is needed to build an app. Regenerate
# with `tools/build-netsurf regen` if a library is ever re-pinned.
set -euo pipefail

SDK="$(cd "$(dirname "$0")/.." && pwd)"
V="$SDK/vendor/netsurf-symbian"
CROSS="$SDK/toolchain/cross/bin"
TC=arm-none-symbianelf
: "${EPOCROOT:=$SDK/sdk}"
OUT="$V/build/armv5"

LIBS="libwapcaplet libparserutils libhubbub libdom libcss"

# --------------------------------------------------------------- regeneration
# Only for re-pinning an upstream version. Needs perl, gperf and a host cc; the
# normal build needs none of the three.
if [ "${1:-build}" = regen ]; then
  echo "--> regenerating the four generated files (needs perl, gperf, cc)"
  # libparserutils: the charset alias table, from build/Aliases.
  ( cd "$V/libparserutils" && perl build/make-aliases.pl )
  # libhubbub: the HTML named-entity table, from build/Entities.
  ( cd "$V/libhubbub" && perl build/make-entities.pl )
  # libhubbub: a gperf perfect hash over the HTML element names. The sed is
  # upstream's: gperf emits the table as external linkage and element-type.c
  # #includes the result, so without it the symbol escapes into the archive.
  ( cd "$V/libhubbub" \
    && gperf --output-file=/tmp/ns-aet.$$ src/treebuilder/element-type.gperf \
    && sed -e 's/^\(const struct element_type_map\)/static \1/' /tmp/ns-aet.$$ \
         > src/treebuilder/autogenerated-element-type.c \
    && rm -f /tmp/ns-aet.$$ )
  # libcss: one property parser per line of properties.gen, emitted by a host tool
  # built from css_property_parser_gen.c, which `fetch` parks in libcss/hostgen/ rather
  # than leaving in src/: it is a main() over fopen/fprintf/exit, and a target build that
  # has to know to skip a file is a target build that will one day forget to.
  ( cd "$V/libcss" && props=$(perl -pe'$_="" unless /^([^\#][^:]+):/;$_=$1 . " "' \
        src/parse/properties/properties.gen) \
    && cc -O2 -o /tmp/ns-genparser.$$ hostgen/css_property_parser_gen.c \
    && for p in $props; do
         /tmp/ns-genparser.$$ -o "src/parse/properties/autogenerated_$p.c" \
           "$(grep "^$p:" src/parse/properties/properties.gen)"
       done \
    && rm -f /tmp/ns-genparser.$$ )
  exit 0
fi

if [ "${1:-build}" = clean ]; then rm -rf "$V/build"; echo "cleaned"; exit 0; fi

# ------------------------------------------------------------------- fetching
# /vendor/ is in .gitignore, so a fresh clone has no sources at all — only this script and
# vendor/netsurf-symbian/README.md, which is force-added for exactly this reason. This
# subcommand is what turns those two files back into a buildable tree.
#
# The commits are pinned here as well as in the README, and pinned rather than tagged
# because only libcss carries release tags on the mirror. Five libraries that have to agree
# with each other are better pinned by one date than by five tag schemes.
if [ "${1:-build}" = fetch ]; then
  needs_gen=0
  fetch_one() { # name commit
    local name=$1 commit=$2
    if [ -d "$V/$name" ]; then echo "  $name already present, skipping"; return; fi
    echo "--> fetching $name @ $commit"
    local tmp; tmp=$(mktemp -d)
    git clone -q "https://github.com/netsurf-browser/$name.git" "$tmp/$name"
    ( cd "$tmp/$name" && git checkout -q "$commit" )
    mkdir -p "$V/$name"
    cp -r "$tmp/$name/include" "$tmp/$name/src" "$V/$name/"
    cp "$tmp/$name/COPYING" "$V/$name/"
    [ -d "$tmp/$name/build" ] && cp -r "$tmp/$name/build" "$V/$name/"
    # libdom only: the libhubbub binding, and the symlink that puts its headers at the path
    # upstream's own Makefile installs them to. Copying the headers instead would be the one
    # kind of duplication that goes wrong silently.
    if [ "$name" = libdom ]; then
      cp -r "$tmp/$name/bindings" "$V/$name/"
      rm -rf "$V/$name/bindings/xml"          # the libxml2 binding; libxml2 is not on the handset
      ln -sfn ../../bindings "$V/$name/include/dom/bindings"
    fi
    # The NetSurf buildsystem's per-directory makefiles. This script replaces all of it.
    find "$V/$name" -name Makefile -delete
    # libcss only: the host generator for the 119 property parsers. Kept OUT of the tree —
    # it is a main() over fopen/fprintf/exit, and a target build that has to know to skip a
    # file is a target build that will one day forget to. Stashed for `regen` instead.
    if [ "$name" = libcss ]; then
      mkdir -p "$V/$name/hostgen"
      mv "$V/$name/src/parse/properties/css_property_parser_gen.c" "$V/$name/hostgen/"
    fi
    rm -rf "$tmp"
    needs_gen=1
  }

  fetch_one libwapcaplet   c7c128d3eb3223b216c974471f82e9337fbcf4ba
  fetch_one libparserutils 6b0cbf086ca8eb8fe74b69f0c9ecf274eb2397ca
  fetch_one libhubbub      6651b8cf87a4aa87bcdb2ff024a02659cd3f9402
  fetch_one libdom         f69781e1f062444b5af3f62d431d7d94018da53b
  fetch_one libcss         499f1c4601ad39942fd1b2204053a387bec9b989

  if [ "$needs_gen" = 1 ]; then
    echo "--> now run: tools/build-netsurf regen   (needs perl, gperf, cc)"
  fi
  exit 0
fi

GCC_INC="$("$CROSS/$TC-gcc" -print-file-name=include)"

# Include order is the whole story of this build, so it is spelled out rather than
# inherited from symbuild's C++ recipe:
#
#   -nostdinc            the host's headers would be actively wrong.
#   -I stdapis           Open C: string.h, stdlib.h, assert.h, iconv.h, stdint.h.
#   -I include           e32def.h and friends, which stdapis reaches for.
#   -isystem $GCC_INC    LAST, and that placement is deliberate. ld searches -I
#                        before -isystem, so Symbian's stdint.h wins over GCC's —
#                        which it must, because they disagree about whether
#                        int32_t is int or long. See symbian/netsurf-symbian.h.
#
# -include gcce.h is not optional: every stdapis prototype is marked IMPORT_C, and
# IMPORT_C is defined nowhere else. Without it the first #include <assert.h> is
# "error: expected ';' before 'void'".
CFLAGS=(
  -c -O2 -march=armv5t -msoft-float -mapcs -nostdinc
  -ffunction-sections -fdata-sections
  -std=c99
  -include "$EPOCROOT/epoc32/include/gcce/gcce.h"
  -include "$V/symbian/netsurf-symbian.h"
  -I"$EPOCROOT/epoc32/include/stdapis"
  -I"$EPOCROOT/epoc32/include"
  -I"$EPOCROOT/epoc32/include/variant"
  -isystem "$GCC_INC"
  -D__SYMBIAN32__ -D__GCCE__ -D__EPOC32__ -D__MARM__ -D__EABI__
  -D__MARM_ARMV5__ -D__EXE__ -DNDEBUG
  -D__PRODUCT_INCLUDE__="<variant/${VARIANT_HRH:-symbian_os_v9.3.hrh}>"
  # __declspec(dllimport) on a function is not a thing this GCC target has an
  # attribute for; it parses and warns. The C++ side silences the same warning.
  # Two defines NetSurf's own buildsystem passes for GCC
  # (buildsystem/makefiles/Makefile.gcc:32) and that the sources do not survive without:
  #
  #   _ALIGNED   libcss/src/stylesheet.h ends `struct css_rule { ... } _ALIGNED;`. Left
  #              undefined that is not an attribute, it is a *variable declaration* — a
  #              tentative definition of an object called `_ALIGNED` in every translation
  #              unit that includes the header. Under -fno-common (the GCC 10+ default)
  #              the link then fails with "multiple definition of `_ALIGNED'" once per
  #              property parser: 24 of them, and not one message mentions libcss.
  #   STMTEXPR   turns libwapcaplet's assert-and-return macros into statement
  #              expressions. There is a working fallback, so this one is conformity with
  #              upstream rather than necessity.
  -D_ALIGNED="__attribute__((aligned))" -DSTMTEXPR=1
  -Wno-attributes
  -Wall -Wno-unused-parameter
)

# Every library sees every library's public headers. Cheaper than modelling the
# real graph (wapcaplet <- parserutils <- {hubbub, css}, hubbub+wapcaplet <- dom)
# and there is nothing to gain from being precise: these are include paths, not
# link edges.
INCS=()
for l in $LIBS; do INCS+=(-I"$V/$l/include"); done

mkdir -p "$OUT"
total_ok=0

for l in $LIBS; do
  case $l in
    libdom) PRIV=(-I"$V/$l/src" -I"$V/$l/bindings/hubbub")
            SRCS=$(find "$V/$l/src" "$V/$l/bindings/hubbub" -name '*.c' | sort) ;;
    *)      PRIV=(-I"$V/$l/src")
            # autogenerated-element-type.c is #included by element-type.c, never
            # compiled on its own. Compiling it too gives duplicate definitions of
            # the whole element name table.
            SRCS=$(find "$V/$l/src" -name '*.c' ! -name 'autogenerated-element-type.c' | sort) ;;
  esac

  objs=(); built=0
  for src in $SRCS; do
    rel="${src#$V/$l/}"
    obj="$OUT/$l/${rel//\//_}"; obj="${obj%.c}.o"
    mkdir -p "$(dirname "$obj")"
    if [ ! -f "$obj" ] || [ "$src" -nt "$obj" ]; then
      "$CROSS/$TC-gcc" "${CFLAGS[@]}" "${INCS[@]}" "${PRIV[@]}" -o "$obj" "$src"
      built=$((built + 1))
    fi
    objs+=("$obj")
  done

  if [ "$built" -gt 0 ] || [ ! -f "$OUT/$l.a" ]; then
    rm -f "$OUT/$l.a"
    "$CROSS/$TC-ar" rcs "$OUT/$l.a" "${objs[@]}"
    echo "--> netsurf: $l  ${#objs[@]} objects, $built compiled, $(stat -c%s "$OUT/$l.a") bytes"
  fi
  total_ok=$((total_ok + ${#objs[@]}))
done

echo "--> netsurf: $total_ok objects in $OUT"
