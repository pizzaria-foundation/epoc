#!/bin/bash
# symbuild — drive a Rust+C++ Symbian app from sources to a signed .sisx.
#
# The pipeline, and why each stage exists:
#
#   Rust  --cargo staticlib-->  libapp.a      Rust never links; see targets/README.md
#   C++   --g++ -c---------->   *.o           the shim: everything that may Leave
#   both  --ld -shared------>   app.elf       Symbian EXEs are shared objects so the
#                                             loader can relocate them
#   ELF   --elf2e32-------->    app.exe       E32Image: UIDs, capabilities, heap/stack
#   files --makesis-------->    app.sis       installable as-is on a patched phone
#   sis   --signsis-------->    app.sisx      only when SIGN=1 (see below)
#
# Signing is OFF by default. The target E72 runs a patched installserver
# (Open4All / RomPatcher+), which drops both the signature requirement and the
# capability ceiling — so an unsigned .sis installs directly and may declare
# capabilities beyond the six a self-signed package could ever get. Set SIGN=1
# in app.conf if you need a package for a stock handset.
#
# Usage:
#   symbuild <app-dir>            build and sign
#   symbuild <app-dir> clean
#
# The app directory must contain a manifest named `app.conf`; see
# examples/hello/app.conf for the full set of keys.
set -euo pipefail

SDK="$(cd "$(dirname "$0")/.." && pwd)"
HOST="$SDK/toolchain/host/bin"
CROSS="$SDK/toolchain/cross/bin"
TARGET_JSON="$SDK/targets/armv5te-symbian-eabi.json"
TC=arm-none-symbianelf

APP="${1:?usage: symbuild <app-dir> [clean]}"
APP="$(cd "$APP" && pwd)"
ACTION="${2:-build}"

# Only relevant when SIGN=1. Fedora and RHEL ship OpenSSL with
# rh-allow-sha1-signatures=no, but Symbian 9.x SIS signatures are RSA-with-SHA-1
# (OID 1.2.840.113549.1.1.5) and the device accepts nothing else, so we opt back
# in. Affects both `openssl req` and signsis, which links the same libcrypto.
export OPENSSL_ENABLE_SHA1_SIGNATURES=1

# rcomp shells out to `uidcrc` to stamp the UIDs on a .rsc, and finds it only on
# PATH — it does not look beside itself. Without this, rcomp prints "Failed to
# write UIDs" and exits 0, leaving a .rsc that exists and is unusable.
export PATH="$HOST:$PATH"

# shellcheck source=/dev/null
source "$APP/app.conf"

: "${NAME:?app.conf must set NAME}"
: "${UID3:?app.conf must set UID3}"
: "${CAPABILITIES:=NetworkServices}"
: "${VERSION:=1,0,0}"
: "${VENDOR:=Unknown}"
: "${HEAP:=0x1000,0x400000}"
: "${STACK:=0x8000}"
: "${EPOCROOT:=$SDK/sdk}"
: "${RUST_CRATE:=}"
# Debug logging: DEBUG=1 in app.conf makes `symbian::log!` write to C:\Data\_logs\$NAME.txt.
# Off by default, and off means *absent*: symbian::log::ENABLED is a const read from
# SYMBIAN_DEBUG, so with DEBUG=0 the macro expands to a branch on `false` and neither the
# call nor its format string survives the optimiser. An environment variable rather than a
# cargo feature precisely so no app has to declare anything for this to work.
: "${DEBUG:=0}"
: "${CXX_SOURCES:=}"
# Off by default: the dev handset has a patched installserver.
: "${SIGN:=0}"
# Publish & Subscribe is on by default: the entry! runtime publishes present/step
# telemetry through it (a capability-free, no-library primitive), so every app that draws
# is observable. An app that genuinely wants it out can still set USE_PROP=0.
: "${USE_PROP:=1}"
# EXE or DLL. A DLL here means a Symbian *polymorphic* DLL — one loaded by
# RLibrary::Load and entered through an ordinal, which is the shape every plugin
# interface on this platform uses (MTMs, ECom, FEPs, recognisers).
#
# The two targets differ in more places than a flag: a different startup library
# (edll.lib, not eexe.lib), a different entry symbol, a different linker script, a
# different UID1, and an export table that an EXE simply does not have. They are
# kept as one script rather than two because everything *between* those points —
# the cargo invocation, the C++ flags, e32prep, the e32dump gate — is identical,
# and the last thing this build needs is two copies of the ELF preparation drifting
# apart. Each divergence below is marked `# DLL:`.
#
# A DLL target stops after producing build/$NAME.dll: no resource compilation (a
# DLL has no menu entry, ever) and no .sis (it is bundled into the package of
# whatever EXE loads it, through that app's EXTRA_DLLS).
: "${TARGETTYPE:=EXE}"
case "$TARGETTYPE" in
  EXE|DLL) ;;
  *) echo "app.conf TARGETTYPE must be EXE or DLL, not '$TARGETTYPE'" >&2; exit 1 ;;
esac

# An app built on the shim always needs the whole GUI set, so it is not worth
# making every app.conf repeat it. apparc/cone/eikcore/avkon are the application
# framework; ws32 the window server; fbscli/bitgdi/gdi/fntstr the bitmap and
# graphics context the shim blits through; efsrv/estor the file server, which
# Avkon's resource loading needs whether or not we open a file ourselves.
# fepbase carries the default implementations of MCoeFepAwareTextEditor's own virtuals.
# They are IMPORT_C, so a class deriving from it puts their addresses in its vtable and the
# link fails without them -- and cone.dso, which exports TCoeInputCapabilities including the
# constructor that *takes* one of these editors, exports none of the class itself.
#
# Opt-in, and that is the commdb lesson applied rather than restated: this adds a DLL to the
# import table, and a DLL the handset does not have stops the image loading with no error,
# no log and no report file. examples/selftest deliberately does NOT set this, so it can
# probe for fepbase.dll and still produce a report if the answer is no.
FEP_LIBS=""
if [ "${USE_FEP:-0}" = 1 ]; then
  FEP_LIBS="fepbase"
fi

# USE_MTM=1 adds shim/mtm — the MTM component base classes — to the sources.
#
# It is NOT part of the shim and must never be mixed with it. shim_event.cpp alone has five
# file-scope mutables, and a Symbian 9.x DLL with any writable static data is refused by the
# loader; `tools/e32dump.py --expect-dll` is the gate. The failure without this check is
# e32dump complaining about bssSize in a build whose app.conf looks perfectly innocent, so the
# combination is refused here with the reason named.
#
# It also explains the directory: shim/mtm/src rather than shim/src/mtm, because the shim loop
# below globs shim/src/*.cpp wholesale.
MTM_SRCS=()
MTM_INC=""
if [ "${USE_MTM:-0}" = 1 ]; then
  if [ "${USE_SHIM:-0}" = 1 ] || [ "${USE_SHIM_DAEMON:-0}" = 1 ]; then
    echo "USE_MTM cannot be combined with USE_SHIM or USE_SHIM_DAEMON." >&2
    echo "The shim has file-scope mutable state; a Symbian DLL may have none, and the" >&2
    echo "loader refuses the image. An MTM component DLL links shim/mtm only." >&2
    exit 1
  fi
  [ "$TARGETTYPE" = DLL ] || { echo "USE_MTM needs TARGETTYPE=DLL" >&2; exit 1; }
  for src in "$SDK"/shim/mtm/src/*.cpp; do MTM_SRCS+=("$src"); done
  MTM_INC="-I$SDK/shim/mtm/inc"
  echo "--> mtm base: $(( ${#MTM_SRCS[@]} )) sources from shim/mtm/src"
fi

# USE_RECOG=1 adds shim/recog — the AppArc data-recogniser base class — to the sources.
#
# Same shape and same reasoning as USE_MTM above: a recogniser is a polymorphic DLL loaded into
# the AppArc server's process, so it may hold no writable static data, and the shim (which does)
# must never be linked into it. shim/recog/src rather than shim/src/recog for the same reason —
# the shim loop below globs shim/src/*.cpp wholesale. The recogniser exports exactly one symbol
# (CreateRecognizer at ordinal 1), so it lists no MTM registration machinery: EXPORTS names the
# one factory and the DLL build exits before any resource stage, which is what a legacy
# recogniser wants — apparc discovers it by scanning \sys\bin, with no registration resource.
RECOG_SRCS=()
RECOG_INC=""
if [ "${USE_RECOG:-0}" = 1 ]; then
  if [ "${USE_SHIM:-0}" = 1 ] || [ "${USE_SHIM_DAEMON:-0}" = 1 ]; then
    echo "USE_RECOG cannot be combined with USE_SHIM or USE_SHIM_DAEMON." >&2
    echo "The shim has file-scope mutable state; a Symbian DLL may have none, and the" >&2
    echo "loader refuses the image. A recogniser DLL links shim/recog only." >&2
    exit 1
  fi
  [ "${USE_MTM:-0}" = 1 ] && { echo "USE_RECOG and USE_MTM are two different plugin bases; pick one" >&2; exit 1; }
  [ "$TARGETTYPE" = DLL ] || { echo "USE_RECOG needs TARGETTYPE=DLL" >&2; exit 1; }
  for src in "$SDK"/shim/recog/src/*.cpp; do RECOG_SRCS+=("$src"); done
  RECOG_INC="-I$SDK/shim/recog/inc"
  echo "--> recog base: $(( ${#RECOG_SRCS[@]} )) sources from shim/recog/src"
fi

if [ "${USE_SHIM:-0}" = 1 ]; then
  NET_LIBS=""
  if [ "${USE_NET:-0}" = 1 ]; then
    # esock is the socket server client, insock the IPv4 address and protocol
    # constants, commdb TCommDbConnPref, netmeta the connection preference plumbing
    # underneath it.
    NET_LIBS="esock insock commdb netmeta apgrfx"
  fi
  # apgrfx (the Application Architecture server client) is in the base set: it is present on every
  # Symbian device, so importing it never risks an unsatisfied dependency, and shim_app.cpp's
  # resident-launcher path uses TApaTask from it unconditionally. USE_APPARC's RApaLsSession and
  # CApaCommandLine resolve from the same library, so that gate no longer adds one of its own.
  : "${SYMBIAN_LIBS:=euser apparc apgrfx cone eikcore avkon ws32 fbscli bitgdi gdi fntstr efsrv estor hal $NET_LIBS $FEP_LIBS}"
  if [ "${USE_AKNICON:-0}" = 1 ]; then
    # aknicon is AknIconUtils -- the icon route that reads an app's registered icon FILE, so MIF
    # (scalable) icons work and the mask plane is real. Unlike apgrfx this is NOT in the base set:
    # it is a library no other feature needs, and an import that does not resolve makes the whole
    # image vanish silently (docs/device-notes.md). aknicon.dll is present on the E72 (measured,
    # docs/device-dump.txt) and aknicon.dso ships in the SDK, but the gate stays so the risk is
    # taken by an isolated probe first and never by a resident launcher that has not proven it.
    SYMBIAN_LIBS="$SYMBIAN_LIBS aknicon"
  fi
  if [ "${USE_CLIPBOARD:-0}" = 1 ]; then
    # bafl is CClipboard, etext is CPlainText. The clipboard is a stream store on disk and the
    # document is what Paste knows how to read, so both are needed to put text somewhere another
    # application can take it from.
    SYMBIAN_LIBS="$SYMBIAN_LIBS bafl etext"
  fi
  if [ "${USE_IMAGE:-0}" = 1 ]; then
    SYMBIAN_LIBS="$SYMBIAN_LIBS imageconversion"
  fi
  if [ "${USE_AUDIO:-0}" = 1 ]; then
    # mediaclientaudio is CMdaAudioPlayerUtility. Playback needs no capability: the
    # SDK's own CLFExample links this and ships `capability none`.
    SYMBIAN_LIBS="$SYMBIAN_LIBS mediaclientaudio"
  fi
  if [ "${USE_SQL:-0}" = 1 ]; then
    # sqldb is RSqlDatabase and RSqlStatement -- Symbian SQL, which is SQLite behind a
    # client-server API. A non-secure database under the app's private path needs no
    # capability.
    #
    # The header is in the public SDK and the exports are in sqldb.dso, but the API is
    # marked @prototype and no shipped SDK example links it, so unlike mediaclientaudio
    # there is no precedent here saying the handset has the DLL. examples/sqlprobe is
    # that precedent: run it before setting this in an app that matters.
    SYMBIAN_LIBS="$SYMBIAN_LIBS sqldb"
  fi
  # An escape hatch for a library exactly one app needs, so that a one-off does not have
  # to earn a USE_* flag in this file and a branch in the source gate below.
  #
  # It exists for examples/keydump, which links ptiengine to read the handset's own
  # keymap out of it once and bake the answer into a static table. No shipping app should
  # ever set this: every library named here becomes an import, and an import the handset
  # cannot satisfy stops the image loading with no error, no log and no report file. Ask
  # examples/libprobe first — that is what it is for.
  if [ -n "${EXTRA_LIBS:-}" ]; then
    SYMBIAN_LIBS="$SYMBIAN_LIBS $EXTRA_LIBS"
  fi
fi

# USE_SQL's library, for a HEADLESS DAEMON too. The USE_SHIM block above (which carries the base
# library set and every other USE_* lib gate) does not run for USE_SHIM_DAEMON, so a daemon that
# opens a database — apps/calsync in the cal repo does — would link shim_sql.o against nothing.
# The GUI path still adds sqldb inside that block; this only fills the daemon gap.
if [ "${USE_SQL:-0}" = 1 ] && [ "${USE_SHIM_DAEMON:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} sqldb"
fi

# Appended *outside* the USE_SHIM branch above, unlike every other USE_* library rule.
#
# Those rules only fire for a GUI app, because SYMBIAN_LIBS is only defaulted there — a
# headless daemon names its own list. But a daemon is exactly where USE_MSG belongs (the
# messaging probe in apps/devdump is one), and a flag that silently added no libraries in
# the one place it is meant to be used would fail at the link with a page of undefined
# references and no hint that the flag was the cause.
#
# msgs is CMsvSession and the message index; mtur the MTM registries on top of it
# (CClientMtmRegistry lives there, not in msgs).
#
# The one library set in this file that is *known* to be a deployment risk. The E72's
# msgs.dll is a 2009 Nokia build and this SDK's import library need not be the same one;
# an ordinal we call that the handset does not export stops the image loading, with no
# error, no log and no report file. Set this only in a binary that has nothing else to
# lose — see apps/devdump.
if [ "${USE_MSG:-0}" = 1 ]; then
  # etext joins msgs and mtur because a message body is a CRichText, which lives there. It is
  # a proven import — the device sweep loaded etext.dll — but it is still an import, and it is
  # only here because writing a body needs it.
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} msgs mtur etext"
fi

# The new-message notification. ecom only: MNcnNotification is resolved as an ECom plugin, so
# there is no library for the implementation itself — which is also why nothing in the device
# sweep could tell us whether ncnnotification.dll is present. Failure is a return code.
if [ "${USE_NCN:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} ecom"
fi

# The Central Repository client. Appended here rather than in the USE_SHIM branch above for the
# same reason USE_MSG is: the first thing to read a CenRep key was a headless daemon, and a
# daemon names its own library list — so a rule that only fired for a GUI app would have added
# nothing in the one place the flag was meant to be used.
#
# This was a real gap: shim_cenrep.cpp has existed since the network daemon needed the Bluetooth
# power key, but nothing here put centralrepository on the link line, so USE_CENREP=1 on its own
# failed at the link with an undefined CRepository::NewL and no hint that the flag was the cause.
# apps/netd worked only because it also named the library by hand.
if [ "${USE_CENREP:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} centralrepository"
fi

# TLS via the platform secure socket (CSecureSocket). The device's ssl.dll is patched by the
# nnproject mbedTLS port to negotiate TLS 1.2 under the native API, so we link ssl + securesocket
# (NOT mbedtls, which is that patch's internal component and faults if called directly). Adds the
# socket libraries too, since shim_tls opens its own RSocket/RConnection.
if [ "${USE_TLS:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} ssl securesocket esock insock commdb netmeta"
fi

# zlib, for reading a gzip file in pieces (shim_gzip.cpp). The platform's own libz.dll — it loads on
# the device with `inflate` resolving (docs/device-dump.txt) — not a vendored copy. Worth having
# whenever a feed is fetched compressed: one measured calendar is 17.4 MB of text and 1.65 MB gzipped.
if [ "${USE_ZLIB:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} libz"
fi

# Bluetooth. Six libraries, and the heaviest import set any flag in this file adds:
#
#   btmanclient     RBTRegServ, RBTRegistry, RBTLocalDevice, TBTRegistrySearch
#   btdevice        CBTDevice, TBTLocalDevice, TBTDeviceSecurity, the name converter
#   bluetooth       the ESock Bluetooth protocol module — KBTAddrFamily, TInquirySockAddr
#   btextnotifiers  the BT notifier plugins reached through RNotifier
#   esock           RSocketServ and RHostResolver, which is how an inquiry is run
#   centralrepository  the power key
#
# All six DLLs loaded in the device sweep (docs/device-dump.txt:208-239). That proves they open;
# it does not prove the ordinals this shim calls are exported by a 2009 Nokia build. So the rule
# is the same one USE_MSG carries: set this in a binary that has nothing else to lose until
# apps/devdump/probes/bt has reported, and never in a resident app before then.
#
# NAMING A LIBRARY HERE DOES NOT NECESSARILY MAKE IT AN IMPORT, and this list is where that got
# measured. The bt probe names ten libraries and its E32 image imports nine: `estor`, `hal` and
# `btextnotifiers` are absent from the import table, because elf2e32 builds that table from the
# symbols actually referenced rather than from the link line. So `btextnotifiers` stays in the
# list for the app that will want the native device-selection notifier, and costs the probe that
# does not call it nothing at all. Check with `python3 tools/e32dump.py <exe>` — it reports the
# DLL count — and `strings -a <exe> | grep .dll` for the names.
if [ "${USE_BT:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} btmanclient btdevice bluetooth btextnotifiers esock centralrepository"
fi

# RFCOMM data sockets + SDP service registration, for the remote-shell agent. Deliberately
# NOT folded into USE_BT: it adds sdpdatabase (RSdp/RSdpDatabase), an import neither the bt
# probe nor anything else here has linked, so it belongs in its own isolated binary until
# that binary has reported. esock and bluetooth carry the RFCOMM socket; the registry
# libraries USE_BT adds are not needed here, so an agent takes this gate and not that one.
if [ "${USE_BTSOCK:-0}" = 1 ]; then
  SYMBIAN_LIBS="${SYMBIAN_LIBS:-euser} esock bluetooth sdpdatabase"
fi

BUILD="$APP/build"
LIBDIR="$EPOCROOT/epoc32/release/armv5/lib"

# The cross compiler's own header directory. Needed because -nostdinc removes it
# along with the host's, and the shim's ABI is written in <stdint.h> types that
# Symbian 9.3 has no header for. Asking gcc rather than hardcoding 15.2.0 means a
# toolchain rebuild does not silently break the shim.
GCC_INC="$("$CROSS/$TC-gcc" -print-file-name=include)"

if [ "$ACTION" = clean ]; then
  rm -rf "$BUILD"
  [ -n "$RUST_CRATE" ] && (cd "$APP/$RUST_CRATE" && cargo clean) || true
  echo "cleaned $NAME"
  exit 0
fi

# UID3 should sit in the unprotected range (>= 0x80000000): 0xE... is the
# development/testing block, 0xA... is for self-signed apps meant for
# distribution. Below 0x80000000 is Symbian-Signed territory, which no longer
# issues. A patched installserver will accept anything, but staying in 0xE keeps
# the package installable on a stock phone too, and avoids colliding with a real
# app's UID — which would silently overwrite it, since UID3 is the identity the
# installer and the data cage both key on.
case "$UID3" in
  0x[eE]*|0x[aA]*) ;;
  *) echo "warning: UID3 $UID3 is outside the unprotected 0xA/0xE ranges" >&2 ;;
esac

mkdir -p "$BUILD"
echo "==> $NAME  (uid3 $UID3, caps: $CAPABILITIES)"

# Telegram credentials, if this app has them. Read here rather than baked into a
# Cargo config so the same tree builds with or without them: a missing api.conf
# leaves the vars unset, the crate falls back to a placeholder, and the failure is
# API_ID_INVALID from the server rather than a build error.
if [ -f "$APP/api.conf" ]; then
  # shellcheck disable=SC1090
  . "$APP/api.conf"
  # Defaulted before export because an api.conf need not carry credentials at all, and under
  # `set -u` exporting an unset var aborted the build with "TG_API_ID: unbound variable" — a
  # Telegram error message on an app that has nothing to do with Telegram.
  : "${TG_API_ID:=}"
  : "${TG_API_HASH:=}"
  export TG_API_ID TG_API_HASH
  if [ -n "$TG_API_ID" ]; then
    echo "--> api credentials: id $TG_API_ID"
  fi
fi

# ---------------------------------------------------------------- profile
# PROFILE=highcap swaps in HIGHCAP_CAPABILITIES and (below) the crate's high-cap cargo
# feature — patched E72 only, where the installserver's capability ceiling is lifted.
# Absent, the app builds stock-safe and installs on any handset.
HIGHCAP=0
if [ "${PROFILE:-}" = highcap ]; then
  HIGHCAP=1
  [ -n "${HIGHCAP_CAPABILITIES:-}" ] && CAPABILITIES="$HIGHCAP_CAPABILITIES"
  echo "--> profile: highcap  (caps: $CAPABILITIES)"
fi

# ---------------------------------------------------------------- 1. Rust
RUST_LIB=""
if [ -n "$RUST_CRATE" ]; then
  echo "--> rust: $RUST_CRATE"
  # Read by `option_env!` in crates/symbian/src/log.rs. The name is exported
  # unconditionally so the log filename is derived from app.conf rather than configured
  # twice; SYMBIAN_DEBUG is exported only when on, because the const there tests presence
  # and an exported empty string is still present.
  export SYMBIAN_APP_NAME="$NAME"
  if [ "$DEBUG" = 1 ]; then
    export SYMBIAN_DEBUG=1
    echo "    debug log: on  → C:\\Data\\_logs\\$NAME.txt"
  else
    unset SYMBIAN_DEBUG
    echo "    debug log: off"
  fi
  # Collect cargo features from every source that contributes one, comma-joined so a
  # single --features carries them all.
  FEATS=""
  if [ "$HIGHCAP" = 1 ] && [ -n "${HIGHCAP_CARGO_FEATURE:-}" ]; then
    FEATS="${FEATS:+$FEATS,}$HIGHCAP_CARGO_FEATURE"
    echo "    high-cap cargo feature: $HIGHCAP_CARGO_FEATURE"
  fi
  # USE_CLIPBOARD wires the system clipboard into entry! (copy/paste in every text field), on top
  # of linking the clipboard shim. The feature lives on symbian-app, a direct dep of the device
  # crate, so the dep/feature syntax reaches it.
  if [ "${USE_CLIPBOARD:-0}" = 1 ]; then
    FEATS="${FEATS:+$FEATS,}symbian-app/clipboard"
    echo "    clipboard: on (entry! injects SystemClipboard)"
  fi
  CARGO_FEATURES=()
  [ -n "$FEATS" ] && CARGO_FEATURES=(--features "$FEATS")
  ( cd "$APP/$RUST_CRATE" && \
    cargo +nightly build --release \
      -Zjson-target-spec \
      -Zbuild-std=core,alloc \
      -Zbuild-std-features=compiler-builtins-mem \
      ${CARGO_FEATURES[@]+"${CARGO_FEATURES[@]}"} \
      --target "$TARGET_JSON" )
  tgt="$(basename "$TARGET_JSON" .json)"
  RUST_LIB="$(find "$APP/$RUST_CRATE/target/$tgt/release" -maxdepth 1 -name 'lib*.a' | head -1)"
  [ -n "$RUST_LIB" ] || { echo "no staticlib produced; is crate-type=[\"staticlib\"]?" >&2; exit 1; }
  echo "    $(basename "$RUST_LIB") $(stat -c%s "$RUST_LIB") bytes"
fi

# --------------------------------- 2p. a UI-data component's resource, compiled first
# Before the C++, and that ordering is a requirement rather than a preference.
#
# rcomp writes a .rsg naming every resource in the file, and a component that opens one of its
# own dialogs needs those ids at *compile* time — `R_MTMDEMO_REPLY_QUERY + offset`. Compiling
# the resource after the link, where this used to live, meant the header did not exist when the
# sources were compiled, so a clean build could not see it at all.
#
# Nothing here depends on the link, unlike the registration resource in 4a, which is generated
# from the .def and therefore cannot move.
#
# The .rsg lands beside the .rss, in the app's data/ directory, which is on the include path
# below for exactly this reason.
UI_RSG_DIR=""
if [ -n "${MTM_UI_RESOURCE:-}" ]; then
  uisrc="$APP/$MTM_UI_RESOURCE"
  [ -f "$uisrc" ] || { echo "MTM_UI_RESOURCE: $uisrc not found" >&2; exit 1; }
  uibase="$(basename "$uisrc" .rss)"
  echo "--> mtm ui resource (before C++): $uibase.rsc"
  "$CROSS/$TC-g++" -E -P -x c++ -nostdinc \
    -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
    -I"$APP/data" -D_UNICODE -DLANGUAGE_SC "$uisrc" -o "$BUILD/$uibase.rpp"
  ( cd "$(dirname "$uisrc")" && "$HOST/rcomp" -u -o"$BUILD/$uibase.uirsc" \
      -h"$uibase.rsg" -s"$BUILD/$uibase.rpp" )
  # .uirsc rather than .rsc for the same reason 4b uses .mtmrsc: the packaging loop globs
  # "$BUILD"/*.rsc and would sweep this into \resource\apps\, where the framework never
  # looks. The extension is put back at the install path.
  echo "    $uibase.uirsc  $(stat -c%s "$BUILD/$uibase.uirsc") bytes"
fi

if [ -n "${MTM_UI_RESOURCE:-}" ]; then
  UI_RSG_DIR="$(dirname "$APP/$MTM_UI_RESOURCE")"
fi

# ------------------------------------------------------------------ 2. C++
# Sources are gathered from two places: the app's own (relative to app.conf, so
# app.conf stays portable) and the shared shim (USE_SHIM=1). An app that only
# drives Rust through the shim therefore lists no C++ of its own at all.
SRCS=()
for src in $CXX_SOURCES; do SRCS+=("$APP/$src"); done
# The MTM base library, if USE_MTM. Added here rather than to CXX_SOURCES so an app.conf names
# only its own files.
for src in "${MTM_SRCS[@]+"${MTM_SRCS[@]}"}"; do SRCS+=("$src"); done
# The recogniser base, if USE_RECOG. Same rationale as MTM_SRCS: added here, not to
# CXX_SOURCES, so an app.conf names only its own files.
for src in "${RECOG_SRCS[@]+"${RECOG_SRCS[@]}"}"; do SRCS+=("$src"); done
# fepbase carries the default implementations of MCoeFepAwareTextEditor's own virtuals.
# They are IMPORT_C, so a class deriving from it puts their addresses in its vtable and the
# link fails without them -- and cone.dso, which exports TCoeInputCapabilities including the
# constructor that *takes* one of these editors, exports none of the class itself.
#
# Opt-in, and that is the commdb lesson applied rather than restated: this adds a DLL to the
# import table, and a DLL the handset does not have stops the image loading with no error,
# no log and no report file. examples/selftest deliberately does NOT set this, so it can
# probe for fepbase.dll and still produce a report if the answer is no.
FEP_LIBS=""
if [ "${USE_FEP:-0}" = 1 ]; then
  FEP_LIBS="fepbase"
fi

# The shim comes in two shapes. USE_SHIM is the GUI app: shim_app.cpp owns E32Main and the
# whole Avkon stack. USE_SHIM_DAEMON is the headless daemon: shim_daemon.cpp owns E32Main and
# a bare CActiveScheduler, no Avkon, no framebuffer — so shim_app.cpp and shim_gfx.cpp are
# swapped out. Everything else (timers, net, files, P&S) is the same active-object machinery
# either way. Exactly one of the two flags is set.
if [ "${USE_SHIM:-0}" = 1 ] || [ "${USE_SHIM_DAEMON:-0}" = 1 ]; then
  for src in "$SDK"/shim/src/*.cpp; do
    case "$(basename "$src")" in
      # The two entry files are mutually exclusive: the GUI build takes shim_app.cpp, the
      # daemon build takes shim_daemon.cpp, and neither takes the other's — two E32Main /
      # ShimRequestExit definitions would collide.
      shim_app.cpp)
        [ "${USE_SHIM:-0}" = 1 ] || continue
        ;;
      shim_daemon.cpp)
        [ "${USE_SHIM_DAEMON:-0}" = 1 ] || continue
        ;;
      # No framebuffer in a headless daemon.
      shim_gfx.cpp)
        [ "${USE_SHIM_DAEMON:-0}" = 1 ] && continue
        ;;
      # Opt-in, not because the code is optional but because linking it is: an app
      # that never opens a socket should not import the socket server, and
      # --no-undefined checks referenced symbols before --gc-sections gets a chance
      # to sweep them, so the libraries have to be there or the file has to be out.
      shim_net.cpp|shim_work.cpp)
        [ "${USE_NET:-0}" = 1 ] || continue
        ;;
      shim_fep.cpp)
        [ "${USE_FEP:-0}" = 1 ] || continue
        ;;
      # Process launch and Publish & Subscribe, for an app that starts and signals its own
      # headless daemon. Gated because the file that references them must be able to
      # resolve them.
      shim_process.cpp)
        [ "${USE_PROC:-0}" = 1 ] || continue
        ;;
      # Enumerate and launch installed apps through RApaLsSession, for a launcher. Gated
      # because it adds apgrfx to the link line, and an app that never lists apps should not
      # import the application registry.
      shim_apparc.cpp)
        [ "${USE_APPARC:-0}" = 1 ] || continue
        ;;
      shim_prop.cpp)
        [ "${USE_PROP:-0}" = 1 ] || continue
        ;;
      # The system clipboard. Gated because it imports bafl (CClipboard) and etext (CPlainText),
      # neither of which anything else here needs -- and an import that does not resolve makes the
      # whole image fail to load with no panic and no log.
      shim_clip.cpp)
        [ "${USE_CLIPBOARD:-0}" = 1 ] || continue
        ;;
      # Per-thread CPU time (RThread::GetCpuTime) and the process walk around it. Gated because
      # it is the only load measurement the platform has and nobody has yet confirmed this kernel
      # accounts for it -- on some 9.x builds the call answers KErrNotSupported. Kept opt-in so
      # the probe that asks is the only binary paying for the question.
      shim_cpu.cpp)
        [ "${USE_CPUTIME:-0}" = 1 ] || continue
        ;;
      # Signal strength via CTelephony. Gated because it imports etel3rdparty — a load risk kept
      # out of every app that does not opt in (only the network daemon does).
      shim_tele.cpp)
        [ "${USE_TELEPHONY:-0}" = 1 ] || continue
        ;;
      # A CenRep read (Bluetooth power state). Gated: centralrepository stays out of apps that do
      # not opt in.
      shim_cenrep.cpp)
        [ "${USE_CENREP:-0}" = 1 ] || continue
        ;;
      # Bluetooth: the registry, the local-device record, the power key and an inquiry. The
      # heaviest gate in this file — six imports at once, and the device sweep proved only that
      # the DLLs open, not that these ordinals exist. Belongs in an isolated probe until that
      # probe has reported. See the header of shim_bt.cpp.
      shim_bt.cpp)
        [ "${USE_BT:-0}" = 1 ] || continue
        ;;
      # RFCOMM data sockets and SDP service registration for the remote-shell agent. Its own
      # gate, not USE_BT: it adds sdpdatabase, an import nothing here has linked before, so it
      # rides in an isolated probe first. See the header of shim_btsock.cpp.
      shim_btsock.cpp)
        [ "${USE_BTSOCK:-0}" = 1 ] || continue
        ;;
      # Same reason, and the one that caught us: the file was compiled
      # unconditionally while imageconversion stayed behind USE_IMAGE, so every
      # shim app that does not decode images failed to link on CImageDecoder.
      shim_image.cpp)
        [ "${USE_IMAGE:-0}" = 1 ] || continue
        ;;
      shim_audio.cpp)
        [ "${USE_AUDIO:-0}" = 1 ] || continue
        ;;
      # Same gate as the audio and image files: the source references RSqlDatabase, so it
      # can only be compiled where sqldb.dso is on the link line.
      shim_sql.cpp)
        [ "${USE_SQL:-0}" = 1 ] || continue
        ;;
      # Free-RAM and own-heap readings, for an app that watches its own footprint.
      shim_mem.cpp)
        [ "${USE_MEM:-0}" = 1 ] || continue
        ;;
      # Device inventory. hal is already in the shim's base library set, so this one
      # costs no new import — it is gated only so a probe binary that does not ask
      # about the hardware does not carry the code.
      shim_hal.cpp)
        [ "${USE_HAL:-0}" = 1 ] || continue
        ;;
      # Drive and volume enumeration. efsrv only, also already in the base set.
      shim_vol.cpp)
        [ "${USE_FS_INFO:-0}" = 1 ] || continue
        ;;
      # Capability self-check. euser only.
      shim_caps.cpp)
        [ "${USE_CAPS:-0}" = 1 ] || continue
        ;;
      # Read-only Message Server access. Unlike every other gate above, this one adds an
      # import the handset may not satisfy — msgs.dso — so the file it guards belongs in
      # a binary of its own and in nothing else. See the header of shim_msg.cpp.
      shim_msg.cpp)
        [ "${USE_MSG:-0}" = 1 ] || continue
        ;;
      # Loading a polymorphic DLL through RLibrary and calling its ordinal 1. euser only —
      # the DLL under test is loaded at runtime, never linked, which is exactly what keeps
      # it off every other binary's critical path.
      shim_dllprobe.cpp)
        [ "${USE_DLL_PROBE:-0}" = 1 ] || continue
        ;;
      # The platform's new-message notification, through the ECom interface it publishes for
      # messaging plugins. Its own gate rather than riding USE_MSG, because it adds ecom.dso
      # and because a binary may want the message store without raising notifications.
      shim_ncn.cpp)
        [ "${USE_NCN:-0}" = 1 ] || continue
        ;;
      # HTTPS via the vendored mbedTLS port. Blocking (WaitForRequest) — headless helpers only.
      shim_tls.cpp)
        [ "${USE_TLS:-0}" = 1 ] || continue
        ;;
      # Inflating a gzip file a chunk at a time. Synchronous CPU work: no worker thread, safe from
      # a daemon's pump, unlike shim_tls beside it.
      shim_gzip.cpp)
        [ "${USE_ZLIB:-0}" = 1 ] || continue
        ;;
    esac
    SRCS+=("$src")
  done
fi

OBJS=()
if [ ${#SRCS[@]} -gt 0 ]; then
  echo "--> c++ (${#SRCS[@]} sources)"
  for src in "${SRCS[@]}"; do
    obj="$BUILD/$(basename "${src%.*}").o"
    # -fno-exceptions/-fno-rtti: Symbian 9.x uses its own Leave/TRAP mechanism and
    # supplies no GCC C++ runtime. -D__SYMBIAN32__ et al mirror what the SDK's own
    # GCCE recipe passes.
    # Flags mirror the SDK's own epoc32/tools/compilation_config/gcce.mk, minus
    # -fno-unit-at-a-time which no longer exists in GCC.
    #
    # -fexceptions and -D__SUPPORT_CPP_EXCEPTIONS__ are load-bearing, not
    # cosmetic. symbian_os_v9.3.hrh says __LEAVE_EQUALS_THROW__ is switched off
    # automatically unless __SUPPORT_CPP_EXCEPTIONS__ (which "the tools" are
    # expected to define) is present. Without it TRAPD falls back to the legacy
    # TTrap mechanism, whose implementation is not in the public SDK at all —
    # TTrap::Trap and TTrap::UnTrap appear in no .dso and no .lib, and the link
    # dies. With it, a Leave is a throw and a TRAP is a catch, which is what
    # Symbian 9.x actually does.
    #
    # The variant header is lowercase: GnuPoc's case fixups leave
    # symbian_os_v9.3.hrh with no capitalised twin, unlike Symbian_OS.hrh.
    # -isystem <gcc include>: -nostdinc drops the compiler's own headers along with
    # the host's, and Symbian 9.3 predates <stdint.h> — it has no e32 equivalent.
    # The shim's ABI is spelled in uint32_t, so this is not optional.
    #
    # -Wno-narrowing: the SDK's own vwsdef.h brace-initialises a TUid from a value
    # that does not fit TInt32, which C++11 promoted from warning to error.
    "$CROSS/$TC-g++" -c -O2 -march=armv5t -msoft-float -mapcs -nostdinc \
      -ffunction-sections -fdata-sections \
      -isystem "$GCC_INC" \
      -include "$EPOCROOT/epoc32/include/gcce/gcce.h" \
      -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
      -I"$EPOCROOT/epoc32/include/stdapis" \
      -D__SYMBIAN32__ -D__GCCE__ -D__EPOC32__ -D__MARM__ -D__EABI__ \
      -D__MARM_ARMV5__ "-D__${TARGETTYPE}__" -D_UNICODE -DNDEBUG \
      -D__SUPPORT_CPP_EXCEPTIONS__ \
      -D__PRODUCT_INCLUDE__="<variant/${VARIANT_HRH:-symbian_os_v9.3.hrh}>" \
      -DSHIM_APP_UID3="$UID3" \
      ${USE_NET:+$([ "$USE_NET" = 1 ] && echo -DSHIM_USE_NET)} \
      ${USE_FEP:+$([ "$USE_FEP" = 1 ] && echo -DSHIM_USE_FEP)} \
      ${USE_IMAGE:+$([ "$USE_IMAGE" = 1 ] && echo -DSHIM_USE_IMAGE)} \
      ${USE_AUDIO:+$([ "$USE_AUDIO" = 1 ] && echo -DSHIM_USE_AUDIO)} \
      ${USE_SQL:+$([ "$USE_SQL" = 1 ] && echo -DSHIM_USE_SQL)} \
      ${USE_PROC:+$([ "$USE_PROC" = 1 ] && echo -DSHIM_USE_PROC)} \
      ${USE_APPARC:+$([ "$USE_APPARC" = 1 ] && echo -DSHIM_USE_APPARC)} \
      ${USE_CPUTIME:+$([ "$USE_CPUTIME" = 1 ] && echo -DSHIM_USE_CPUTIME)} \
      ${USE_APPICON:+$([ "$USE_APPICON" = 1 ] && echo -DSHIM_USE_APPICON)} \
      ${USE_AKNICON:+$([ "$USE_AKNICON" = 1 ] && echo -DSHIM_USE_AKNICON)} \
      ${USE_LAUNCH_DOC:+$([ "$USE_LAUNCH_DOC" = 1 ] && echo -DSHIM_USE_LAUNCH_DOC)} \
      ${USE_CLIPBOARD:+$([ "$USE_CLIPBOARD" = 1 ] && echo -DSHIM_USE_CLIPBOARD)} \
      ${USE_TELEPHONY:+$([ "$USE_TELEPHONY" = 1 ] && echo -DSHIM_USE_TELEPHONY)} \
      ${USE_CENREP:+$([ "$USE_CENREP" = 1 ] && echo -DSHIM_USE_CENREP)} \
      ${USE_BT:+$([ "$USE_BT" = 1 ] && echo -DSHIM_USE_BT)} \
      ${USE_BTSOCK:+$([ "$USE_BTSOCK" = 1 ] && echo -DSHIM_USE_BTSOCK)} \
      ${USE_PROP:+$([ "$USE_PROP" = 1 ] && echo -DSHIM_USE_PROP)} \
      ${USE_MEM:+$([ "$USE_MEM" = 1 ] && echo -DSHIM_USE_MEM)} \
      ${USE_HAL:+$([ "$USE_HAL" = 1 ] && echo -DSHIM_USE_HAL)} \
      ${USE_ZLIB:+$([ "$USE_ZLIB" = 1 ] && echo -DSHIM_USE_ZLIB)} \
      ${USE_FS_INFO:+$([ "$USE_FS_INFO" = 1 ] && echo -DSHIM_USE_FS_INFO)} \
      ${USE_CAPS:+$([ "$USE_CAPS" = 1 ] && echo -DSHIM_USE_CAPS)} \
      ${USE_MSG:+$([ "$USE_MSG" = 1 ] && echo -DSHIM_USE_MSG)} \
      ${USE_DLL_PROBE:+$([ "$USE_DLL_PROBE" = 1 ] && echo -DSHIM_USE_DLL_PROBE)} \
      ${USE_NCN:+$([ "$USE_NCN" = 1 ] && echo -DSHIM_USE_NCN)} \
      ${USE_TLS:+$([ "$USE_TLS" = 1 ] && echo -DSHIM_USE_TLS)} \
      ${USE_KEYLOG:+$([ "$USE_KEYLOG" = 1 ] && echo -DSHIM_KEYLOG)} \
      -fexceptions -fno-rtti \
      -Wall -Wno-narrowing -Wno-ctor-dtor-privacy -Wno-unknown-pragmas \
      -Wno-attributes \
      ${MTM_TRACE:+$([ "$MTM_TRACE" = 1 ] && echo -DMTM_TRACE)} \
      -I"$APP/inc" -I"$APP/data" -I"$SDK/shim/inc" ${MTM_INC:-} ${RECOG_INC:-} ${CXX_FLAGS:-} \
      "$src" -o "$obj"
    OBJS+=("$obj")
  done
fi

[ ${#OBJS[@]} -gt 0 ] || [ -n "$RUST_LIB" ] || { echo "nothing to build" >&2; exit 1; }

# ----------------------------------------------------------------- 3. link
echo "--> link"
LIBGCC_DIR="$(dirname "$("$CROSS/$TC-gcc" -print-libgcc-file-name)")"

# --target1-abs: R_ARM_TARGET1 must resolve to ABS32, not REL32. ld enables this
# implicitly for a real symbianelf BFD target, but our binutils aliases symbianelf
# onto the plain EABI config (see toolchain/patches/), so we pass it explicitly.
# Getting it wrong yields REL32 where elf2e32 accepts only ABS32, and the
# relocation is silently dropped.
#
# -shared: E32 images are relocatable shared objects, not ET_EXEC. elf2e32 reads
# the PT_LOAD program headers to find codeBase (R+X) and dataBase/bssSize (R+W).
#
# STATLINK holds the per-variant static libraries, which live beside the built
# binaries rather than in lib/: eexe.lib carries _E32Startup, and usrt2_2.lib the
# user-side runtime (CallThrdProcEntry and friends).
STATLINK="$EPOCROOT/epoc32/release/armv5/${VARIANT:-urel}"

# Runtime import libraries, in the order the SDK's gcce.mk demands — scppnwdl
# before drtrvct2_2, or operator new resolves to the wrong implementation.
RT_LIBS=(dfpaeabi.dso dfprvct2_2.dso drtaeabi.dso scppnwdl.dso drtrvct2_2.dso)

LINK_LIBS=()
for l in ${SYMBIAN_LIBS:-euser}; do LINK_LIBS+=("-l:$l.dso"); done
for l in "${RT_LIBS[@]}"; do LINK_LIBS+=("-l:$l"); done

# -lsupc++ supplies __gxx_personality_v0. Symbian's drtaeabi.dso covers the
# __cxa_* and __aeabi_unwind_cpp_pr* half of the ARM C++ ABI but not GCC's
# personality routine, and with exceptions on (see above) every TRAP needs it.
# --gc-sections earns its place: compiler_builtins ships the whole soft-float libm
# (erfc, lgamma, pow, cbrt, the f128 helpers) because the target declares no system
# libm, and without sweeping, 136 KB of math this app never calls was 78% of a
# 305 KB image. Rust already emits one section per function; -ffunction-sections
# above does the same for the shim.
#
# The two -u roots are functions the *kernel* calls, never our code: they are named
# by the exception descriptor rather than referenced by a relocation, so a sweep
# would take them. .emb_text is KEEP'd in the linker script for the same reason.
#
# DLL: four substitutions, plus one addition.
#
#   edll.lib for eexe.lib     — it carries _E32Dll and the exception descriptor.
#   _E32Dll for _E32Startup   — the default ENTRY, still overridable.
#   symbian-dll.lds           — see the header of that file.
#   --version-script          — the addition, and the load-bearing one.
#
# elf2e32 builds a DLL's export table from .dynsym: every STB_GLOBAL FUNC or
# OBJECT with a nonzero value, sorted by name and numbered from 1
# (vendor/gnupoc-git/tools/elf2e32/elf2e32.cpp:156). Under -shared, ld puts every
# global symbol there — including ones dragged in from usrt2_2.lib and libsupc++.
# Left alone, the export table is therefore whatever the static libraries happened
# to leak, and adding an unrelated call to the app can renumber every ordinal.
#
# That is not a theoretical tidiness problem: an ordinal is the entire calling
# convention of a polymorphic DLL. The version script pins the export set to
# exactly the names app.conf declares in EXPORTS, and localises everything else,
# so the ordinals are a property of app.conf rather than of link order.
LINK_STARTUP="$STATLINK/eexe.lib"
LINK_ENTRY="${ENTRY:-_E32Startup}"
LINK_LDS="$SDK/toolchain/symbian-exe.lds"
LINK_EXTRA=()
if [ "$TARGETTYPE" = DLL ]; then
  LINK_STARTUP="$STATLINK/edll.lib"
  LINK_ENTRY="${ENTRY:-_E32Dll}"
  LINK_LDS="$SDK/toolchain/symbian-dll.lds"
  : "${EXPORTS:?a DLL must set EXPORTS in app.conf: the symbols, in ordinal order}"
  # Written fresh every build from EXPORTS, so the file cannot drift from the
  # manifest. Ordinals come out of elf2e32's name sort, so the ordinal a caller
  # uses is only stable while the export set is — which is why a DLL that grows a
  # second export should move to a frozen .def rather than re-sorting under its
  # own callers. With one export the question does not arise.
  {
    echo "/* Generated by symbuild from EXPORTS in app.conf — do not edit. */"
    echo "SYMBIAN_DLL {"
    echo "  global:"
    for s in $EXPORTS; do echo "    $s;"; done
    echo "  local:"
    echo "    *;"
    echo "};"
  } > "$BUILD/$NAME.ver"
  LINK_EXTRA+=(--version-script "$BUILD/$NAME.ver")
  # Rooted against --gc-sections for the same reason the entry point is: with the
  # version script in place nothing in the image references them.
  for s in $EXPORTS; do LINK_EXTRA+=(-u "$s"); done
  echo "--> exports: $EXPORTS"
fi

"$CROSS/$TC-ld" -shared --target1-abs --no-undefined -nostdlib \
  --entry "$LINK_ENTRY" -u "$LINK_ENTRY" \
  --gc-sections \
  -u _xxxx_call_user_invariant -u _xxxx_call_user_handle_exception \
  --default-symver \
  ${LINK_EXTRA[@]+"${LINK_EXTRA[@]}"} \
  -T "$LINK_LDS" \
  "$LINK_STARTUP" \
  ${OBJS[@]+"${OBJS[@]}"} ${RUST_LIB:+"$RUST_LIB"} \
  --start-group "$STATLINK/usrt2_2.lib" --end-group \
  -L"$LIBDIR" "${LINK_LIBS[@]}" \
  -L"$LIBGCC_DIR" -lsupc++ -lgcc \
  -o "$BUILD/$NAME.elf"

# No -Ttext. It fights -shared: it relocates only .text and strands every other
# section at its natural address, which put codeBase at 0xc748 instead of 0x8000.
# The linker script owns the layout.

"$CROSS/$TC-readelf" -l "$BUILD/$NAME.elf" | grep -E '^  LOAD' | sed 's/^/    /'

# -------------------------------------------------- 3b. prepare the ELF for elf2e32
# Clears SHF_ALLOC on the link-time-only sections and zeroes the GOT, by rewriting
# the section header table in place.
#
# Both halves are load-bearing. elf2e32 concatenates *every* SHF_ALLOC section into
# the code segment, so leaving the dynamic-linking metadata marked baked 18 KB of
# .dynsym and friends into the image and pushed codeBase off 0x8000. And GNU ld
# pre-fills .got with PLT stub addresses for lazy binding, which elf2e32 reads as
# relocation addends — 81 of 230 imports came out pointing at 0xa3ac000e.
#
# Not objcopy: --set-section-flags reclassified .rel.plt and discarded its 82
# R_ARM_JUMP_SLOT relocations, dropping dllRefTableCount from 12 to 6 without a
# word of complaint. See tools/e32prep.py.
echo "--> prepare ELF"
python3 "$SDK/tools/e32prep.py" "$BUILD/$NAME.elf"

# ---------------------------------------------------------------- 4. elf2e32
echo "--> elf2e32"
# DLL: UID1 is the image type and the loader reads it before anything else —
# 0x1000007a is KExecutableImageUid, 0x10000079 KDynamicLibraryUid. UID2 for an
# EXE defaults to the S60 GUI application UID; for a DLL it is the polymorphic
# interface the DLL implements, which only its loader cares about, so a plain
# load-and-call test can leave it at the SDK's own generic value.
#
# --heap and --stack are process attributes and mean nothing for a DLL: it runs on
# the heap and stack of whoever loaded it. Passing them anyway would put values in
# the header that no loader reads and every reader would have to explain.
#
# --defoutput writes the .def recording which name got which ordinal. Nothing in
# the build consumes it, and that is exactly why it is worth writing: it is the
# only human-readable record of the export numbering, and diffing it across builds
# is how a silently renumbered ordinal gets caught.
E32_ARGS=(
  --uncompressed
  --sid="$UID3"
  --uid3="$UID3"
  --vid=0x00000000
  --capability="$CAPABILITIES"
  --fpu=softvfp
  --libpath="$LIBDIR/"
  --elfinput="$BUILD/$NAME.elf"
)
if [ "$TARGETTYPE" = DLL ]; then
  OUTBIN="$BUILD/$NAME.dll"
  E32_ARGS+=(
    --uid1=0x10000079
    --uid2="${UID2:-0x1000008d}"
    --targettype=DLL
    --linkas="$NAME{000a0000}.dll"
    --output="$OUTBIN"
    --defoutput="$BUILD/$NAME.def"
    --dso="$BUILD/$NAME.dso"
  )
else
  OUTBIN="$BUILD/$NAME.exe"
  E32_ARGS+=(
    --uid1=0x1000007a
    --uid2="${UID2:-0x100039ce}"
    --targettype=EXE
    --linkas="$NAME{000a0000}.exe"
    --output="$OUTBIN"
    --heap="$HEAP"
    --stack="$STACK"
  )
fi
"$HOST/elf2e32" "${E32_ARGS[@]}"
echo "    $(basename "$OUTBIN") $(stat -c%s "$OUTBIN") bytes"

# Validate before packaging. A malformed E32 is refused by the device with no
# error, no panic and no log entry — it simply does nothing when you tap the icon
# — so every check that can run here saves an install round trip. e32dump also
# re-derives the UID checksum and the header CRC independently of elf2e32, which
# is how you catch the tool itself being wrong.
#
# DLL: --expect-dll additionally requires the DLL flag and a non-empty export
# table. A DLL that exports nothing links, packages, installs and then fails at
# RLibrary::Lookup on the handset — the far end of the loop this whole gate exists
# to shorten.
python3 "$SDK/tools/e32dump.py" "$OUTBIN" --quiet \
  ${TARGETTYPE:+$([ "$TARGETTYPE" = DLL ] && echo --expect-dll)}
echo "    header validated"

# ------------------------------------------- 4a. MTM registration, generated from the .def
# An MTM's registration names, for each of the four component slots, the DLL and the ORDINAL
# of its factory. Get an ordinal wrong and the framework enters the wrong function with the
# wrong signature — inside its own process.
#
# The ordinals cannot be known from the source: elf2e32 numbers exports by sorting their
# names (vendor/gnupoc-git/tools/elf2e32/elf2e32.cpp:156), so declaration order says nothing.
# It does write build/$NAME.def recording what it chose, and that is what this reads.
#
# So the registration is generated: app.conf names the C symbol for each slot, and the
# ordinal comes from the linker's own record. The two cannot disagree, and a rename that
# reshuffles the sort corrects the resource instead of silently invalidating it.
#
# All four slots are filled whether or not all four components exist, because
# CObserverRegistry::HandleSessionEventL indexes the declared array by fixed slot with no
# bounds check — a shorter array is a panic in the Message Server's client, not an error.
# See apps/mtmdemo/src/mtmclient.cpp.
if [ -n "${MTM_RESOURCE_TEMPLATE:-}" ]; then
  [ "$TARGETTYPE" = DLL ] || { echo "MTM_RESOURCE_TEMPLATE needs TARGETTYPE=DLL" >&2; exit 1; }
  : "${MTM_TYPE_UID:?MTM_RESOURCE_TEMPLATE needs MTM_TYPE_UID}"
  : "${MTM_TECHNOLOGY_UID:?MTM_RESOURCE_TEMPLATE needs MTM_TECHNOLOGY_UID}"
  : "${MTM_NAME:=$NAME}"

  # Look an export's ordinal up in the .def elf2e32 just wrote. The format is one export per
  # line: "\t<name> @ <ordinal> NONAME ; CODE".
  ordinal_of() {
    local sym="$1" ord
    ord="$(sed -n "s/^\t${sym} @ \([0-9]*\) .*/\1/p" "$BUILD/$NAME.def" | head -1)"
    if [ -z "$ord" ]; then
      echo "MTM registration: export '$sym' is not in $BUILD/$NAME.def." >&2
      echo "Every symbol named by an MTM_*_EXPORT must be in app.conf's EXPORTS." >&2
      exit 1
    fi
    printf '%s' "$ord"
  }

  # Absolute paths pass through, so a service can point at the shared template in
  # shim/mtm/data/ rather than keeping a copy. Same shape EXTRA_DLLS already uses, and app.conf
  # is sourced after SDK is set, so "$SDK/shim/mtm/data/mtmreg.rss.in" already expands.
  case "$MTM_RESOURCE_TEMPLATE" in
    /*) MTM_SRC="$MTM_RESOURCE_TEMPLATE" ;;
    *)  MTM_SRC="$APP/$MTM_RESOURCE_TEMPLATE" ;;
  esac
  [ -f "$MTM_SRC" ] || { echo "MTM_RESOURCE_TEMPLATE: $MTM_SRC not found" >&2; exit 1; }
  # Named after the app, NOT after the template. With a shared template every service's
  # registration would otherwise be called mtmreg.rsc and they would collide in the one
  # directory the framework reads, \resource\messaging\mtm\ — the second service installed
  # would silently replace the first.
  MTM_BASE="${NAME}reg"
  MTM_RESOURCE="build/$MTM_BASE.rss"

  echo "--> mtm registration: ordinals from $NAME.def"
  sed -e "s|@MTM_TYPE_UID@|$MTM_TYPE_UID|g" \
      -e "s|@MTM_TECHNOLOGY_UID@|$MTM_TECHNOLOGY_UID|g" \
      -e "s|@MTM_NAME@|$MTM_NAME|g" \
      -e "s|@DLL@|$NAME.dll|g" \
      -e "s|@ORD_SERVER@|$(ordinal_of "${MTM_SERVER_EXPORT:?}")|g" \
      -e "s|@ORD_CLIENT@|$(ordinal_of "${MTM_CLIENT_EXPORT:?}")|g" \
      -e "s|@ORD_UI@|$(ordinal_of "${MTM_UI_EXPORT:?}")|g" \
      -e "s|@ORD_UIDATA@|$(ordinal_of "${MTM_UIDATA_EXPORT:?}")|g" \
      "$MTM_SRC" > "$APP/$MTM_RESOURCE"
  for slot in SERVER CLIENT UI UIDATA; do
    eval "sym=\$MTM_${slot}_EXPORT"
    printf '    %-7s ordinal %s  %s\n' "$slot" "$(ordinal_of "$sym")" "$sym"
  done
fi

# ----------------------------------------------------- 4b. MTM registration resource
# The resource that tells the Message Server a new message type exists.
#
# Its own stage, on the AUTOSTART precedent, for four reasons the general resource loop
# cannot satisfy:
#
#   - it runs even when HEADLESS=1. A registration resource has nothing to do with a menu
#     entry, and the general stage is skipped wholesale for a headless binary — which is
#     exactly the shape an MTM's installer and probe want to be.
#   - it runs on the DLL path, which is where it matters most and where it does not reach if
#     placed with the other resources: a DLL build stops right after elf2e32, so an MTM whose
#     own component builds its own registration would silently produce no resource at all.
#     That cost a build cycle to notice, because nothing errors — the file simply is not
#     there, and the packaging step that wanted it says so much later.
#   - it goes to \resource\messaging\mtm\, not \resource\apps\. The general packaging
#     loop routes every other .rsc to the latter, where the Message Server never looks.
#   - it is named independently of $NAME, because the registration usually belongs to a
#     different component than the binary that installs it.
#
# Compiling it is not enough on its own: an MTM outside ROM has to be handed to the Message
# Server at runtime through CMsvSession::InstallMtmGroup. See symbian::msg::Session::install_mtm.
if [ -n "${MTM_RESOURCE:-}" ]; then
  mtmsrc="$APP/$MTM_RESOURCE"
  [ -f "$mtmsrc" ] || { echo "MTM_RESOURCE: $mtmsrc not found" >&2; exit 1; }
  mtmbase="$(basename "$mtmsrc" .rss)"
  echo "--> mtm registration: $mtmbase.rsc"
  "$CROSS/$TC-g++" -E -P -x c++ -nostdinc \
    -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
    -I"$APP/data" -D_UNICODE -DLANGUAGE_SC "$mtmsrc" -o "$BUILD/$mtmbase.rpp"
  ( cd "$(dirname "$mtmsrc")" && "$HOST/rcomp" -u -o"$BUILD/$mtmbase.mtmrsc" \
      -h"$mtmbase.rsg" -s"$BUILD/$mtmbase.rpp" )
  # Deliberately .mtmrsc and not .rsc: the packaging loop globs "$BUILD"/*.rsc and would
  # otherwise sweep this into \resource\apps\, where nothing would ever read it. The
  # extension is changed back at the install path below.
  echo "    $mtmbase.mtmrsc  $(stat -c%s "$BUILD/$mtmbase.mtmrsc") bytes"
fi

# ------------------------------------ 4c. a UI-data component's resource and icons
# A UI Data MTM opens two files at runtime that nothing else in the build would produce.
#
# CBaseMtmUiData::ConstructL opens whatever GetResourceFileName() returns *before* it calls
# PopulateArraysL, and PopulateArraysL loads the icon array out of an .mbm. Both are opened
# inside whichever application is drawing a message list — the Messaging application among
# them — so a missing file is a Leave during construction in somebody else's process rather
# than a build error here.
#
# Both land in \resource\messaging\, which is where the framework looks and where every one
# of the platform's own UI-data components keeps them (smum.rsc, mmsui.rsc, notui.rsc).
#
# On the DLL path, like 4b, because a UI-data component is a DLL and the general resource and
# icon stages are past the point where a DLL build stops.
#
# The .rss half of this moved to stage 2p, ahead of the C++: the component needs the resource
# ids at compile time. Only the icons are still built here.

if [ -n "${MTM_ICONS:-}" ]; then
  # Generated first if a generator is present, on the same reasoning as the app icon stage:
  # a committed .bmp is a binary nobody can review and the generator is the actual source.
  if [ -f "$APP/data/mkicon.py" ]; then
    python3 "$APP/data/mkicon.py" "$APP/data"
  fi
  echo "--> mtm icons: $NAME.mbm"
  ICON_ARGS=""
  for bmp in $MTM_ICONS; do
    [ -f "$APP/data/$bmp" ] || { echo "MTM_ICONS: $APP/data/$bmp not found" >&2; exit 1; }
    # /c24 glued to the filename, not a separate argument, and every path relative — bmconv
    # parses DOS-style options and reads any leading / as one, so an absolute Unix path
    # becomes garbage. Both quirks cost a build to find, once, for the app icon stage.
    ICON_ARGS="$ICON_ARGS /c24$bmp"
  done
  # Order is the ABI: CreateBitmapsL walks the .mbm from its first bitmap to its last, so the
  # order in MTM_ICONS is the order of the component's icon enum.
  ( cd "$APP/data" && "$HOST/bmconv" /q "../build/$NAME.mbm" $ICON_ARGS )
  echo "    $NAME.mbm  $(stat -c%s "$BUILD/$NAME.mbm") bytes"
fi

# ------------------------------------------- 4d. ECom plugin registration resource
# An ECom plugin (UID2 0x10009D8D, one export ImplementationGroupProxy) is discovered not by a
# \sys\bin scan but by a REGISTRY_INFO resource in \resource\plugins\, which ECom reads to learn
# the DLL's implementations and their interface UIDs. Compile it here, on the DLL path and ahead
# of the exit below, for the same three reasons the MTM stages are here: it must run for a DLL
# (which stops before the general resource stage), it must run under HEADLESS, and it goes to a
# directory the general packaging loop does not route to.
#
# ECOM_RESOURCE names a hand-written .rss in the app (the REGISTRY_INFO block is short and its
# UIDs are fixed, so unlike the MTM registration there is nothing to substitute — no template).
# Emitted as .ecomrsc, not .rsc, so the packaging glob ("$BUILD"/*.rsc) cannot sweep it into
# \resource\apps\; the extension is restored to .rsc at the install path (see EXTRA_ECOM_RESOURCES).
if [ -n "${ECOM_RESOURCE:-}" ]; then
  [ "$TARGETTYPE" = DLL ] || { echo "ECOM_RESOURCE needs TARGETTYPE=DLL" >&2; exit 1; }
  ecomsrc="$APP/$ECOM_RESOURCE"
  [ -f "$ecomsrc" ] || { echo "ECOM_RESOURCE: $ecomsrc not found" >&2; exit 1; }
  ecombase="$(basename "$ecomsrc" .rss)"
  echo "--> ecom registration: $ecombase.rsc"
  "$CROSS/$TC-g++" -E -P -x c++ -nostdinc \
    -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
    -I"$APP/data" -D_UNICODE -DLANGUAGE_SC "$ecomsrc" -o "$BUILD/$ecombase.rpp"
  ( cd "$(dirname "$ecomsrc")" && "$HOST/rcomp" -u -o"$BUILD/$ecombase.ecomrsc" \
      -h"$ecombase.rsg" -s"$BUILD/$ecombase.rpp" )
  echo "    $ecombase.ecomrsc  $(stat -c%s "$BUILD/$ecombase.ecomrsc") bytes"
fi

if [ "$TARGETTYPE" = DLL ]; then
  # A DLL is not installable on its own: it is bundled by the app that loads it,
  # through that app's EXTRA_DLLS. Stop here rather than emitting a .sis nobody
  # should install.
  if [ -f "$BUILD/$NAME.def" ]; then
    echo "--> ordinals"
    sed -n 's/^\t\([^ ]*\) @ \([0-9]*\).*/    \2  \1/p' "$BUILD/$NAME.def"
  fi
  echo "==> $BUILD/$NAME.dll"
  exit 0
fi

# --------------------------------------------------------------- 5. resources
# No registration resource means no menu entry — the package installs, reports success,
# and the application simply is not there. That failure is silent on both sides, so it is
# refused here instead: it cost a build, a Bluetooth transfer and an install to find, and
# the only symptom was "n apareceu na listagem de apps".
#
# A GUI app is one that draws, and every app this toolchain builds draws — except a headless
# daemon, which deliberately has no menu entry and no UI resources. HEADLESS=1 is the
# explicit opt-out this comment used to ask for: it turns the missing _reg.rss from an error
# into the intended state, and skips the whole resource stage below.
if [ "${HEADLESS:-0}" != 1 ] && [ ! -f "$APP/data/${NAME}_reg.rss" ]; then
  echo "no $APP/data/${NAME}_reg.rss — without it the package installs but never appears" >&2
  echo "in the menu. Copy one from another app under examples/, adjusting NAME and UID3." >&2
  echo "(A non-GUI daemon is exempt: set HEADLESS=1 in app.conf.)" >&2
  exit 1
fi
if [ "${HEADLESS:-0}" != 1 ] && [ -f "$APP/data/${NAME}_reg.rss" ]; then
  echo "--> resources"
  # Order matters: ${NAME}_reg.rss #includes the .rsg that compiling $NAME.rss
  # generates, so the UI resource has to be built first.
  for rss in "$APP/data/$NAME.rss" "$APP/data/${NAME}_reg.rss"; do
    [ -f "$rss" ] || continue
    base="$(basename "$rss" .rss)"
    # epocrc is just cpp followed by rcomp; do it by hand so we need no Perl.
    "$CROSS/$TC-g++" -E -P -x c++ -nostdinc \
      -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
      -I"$APP/data" -D_UNICODE -DLANGUAGE_SC "$rss" -o "$BUILD/$base.rpp"
    # rcomp runs from data/ so the -h header lands next to the .rss that will
    # #include it. Run it from build/ and the _reg compile fails to find the .rsg.
    ( cd "$APP/data" && "$HOST/rcomp" -u -o"$BUILD/$base.rsc" \
        -h"$base.rsg" -s"$BUILD/$base.rpp" )
    echo "    $base.rsc"
  done
fi

# --------------------------------------------------------- 5a. autostart resource
# A start-up control file, so the daemon launches at boot. Compiled like any resource
# but installed to the Software Installer's import dir (below), not \resource\apps\.
#
# The S60 Startup List Management API is explicit that the installer only honours this in
# a SIGNED (trusted) SISAPP package — so on the unsigned dev flow it is packaged but the
# installer usually ignores it. Warn, build it anyway, and let the handset be the judge.
# The source resource is either hand-written in the app's data/, or generated here from the
# shared template — the app then supplies only its name, the same shape as the MTM stage above.
# A hand-written file always wins, so an app that needs a non-default start-up item keeps control.
STARTUP_SRC=""
STARTUP_TEMPLATE="$SDK/shim/launcher/data/startup.rss.in"
if [ "${AUTOSTART:-0}" = 1 ]; then
  if [ -f "$APP/data/${NAME}_startup.rss" ]; then
    STARTUP_SRC="$APP/data/${NAME}_startup.rss"
  elif [ -f "$STARTUP_TEMPLATE" ]; then
    STARTUP_SRC="$BUILD/${NAME}_startup.rss"
    # @NAME@ is the only substitution, and it carries no backslashes — the path shape is fixed
    # in the template, which is what keeps this a plain sed and not a backslash-escaping puzzle.
    sed "s|@NAME@|$NAME|g" "$STARTUP_TEMPLATE" > "$STARTUP_SRC"
    echo "--> autostart resource (generated from template)"
  fi
fi
if [ -n "$STARTUP_SRC" ]; then
  echo "--> autostart resource"
  [ "${SIGN:-0}" = 1 ] || echo "    warning: AUTOSTART wants a signed package (SIGN=1); an unsigned installer usually ignores the start-up item" >&2
  "$CROSS/$TC-g++" -E -P -x c++ -nostdinc \
    -I"$EPOCROOT/epoc32/include" -I"$EPOCROOT/epoc32/include/variant" \
    -I"$APP/data" -D_UNICODE -DLANGUAGE_SC "$STARTUP_SRC" -o "$BUILD/${NAME}_startup.rpp"
  ( cd "$(dirname "$STARTUP_SRC")" && "$HOST/rcomp" -u -o"$BUILD/${NAME}_startup.rsc" \
      -h"${NAME}_startup.rsg" -s"$BUILD/${NAME}_startup.rpp" )
  echo "    ${NAME}_startup.rsc"
fi

# ------------------------------------------------------------------- 5b. icon
# A 44x44 EColor64K bitmap plus an 8bpp greyscale mask, packed into an .mbm.
#
# Those depths are not a preference, they are what the platform will load. /c24 gives
# EColor16M — three bytes per pixel, a display mode the E72 does not have and its
# fbserv will not create — so the shell's load of the icon fails and the menu draws
# its default instead: no error, no panic, no log entry, just a missing icon. /c16
# matches the screen. The 8bpp mask is the other half of the same argument — the
# platform's own app icons are 16bpp beside an 8bpp grey mask, \resource\apps\about.mbm
# being the reference — and it buys anti-aliased corners too, where a 1bpp mask is all
# or nothing per pixel and saws the rounded corners flat.
#
# Two bmconv quirks, both learned the hard way:
#   - the depth option is glued to the filename (/c16foo.bmp), not a separate arg;
#   - it parses DOS-style options, so it mistakes ANY argument starting with `/`
#     for one — an absolute Unix path silently becomes garbage. Every path handed
#     to bmconv must be relative, hence the cd.
ICON_MBM=""
# Generated, not committed: a checked-in .bmp is a binary nobody can review, and
# the generator is the actual source. Which means it runs on every build, exactly
# like the MTM icon stage above — guarding it on the .bmp being absent would make
# the first build the only one that reads mkicon.py, and every edit to the icon
# after that would be silently ignored in favour of a stale bitmap.
if [ -f "$APP/data/mkicon.py" ]; then
  python3 "$APP/data/mkicon.py" "$APP/data"
fi
if [ -f "$APP/data/${NAME}_icon.bmp" ]; then
  echo "--> icon"
  ( cd "$APP/data" && "$HOST/bmconv" /q "../build/${NAME}_icon.mbm" \
      "/c16${NAME}_icon.bmp" "/8${NAME}_icon_mask.bmp" )
  ICON_MBM="$BUILD/${NAME}_icon.mbm"
  echo "    ${NAME}_icon.mbm"
fi

# ------------------------------------------------------------------ 6. sign
echo "--> package"
cat > "$BUILD/$NAME.pkg" <<EOF
; Generated by symbuild — do not edit.
&EN
#{"$NAME"},($UID3),$VERSION,TYPE=SISAPP
%{"$VENDOR"}
:"$VENDOR"
; S60 3rd Edition base platform UID. Present on FP1 and FP2 devices too, so
; depending on it rather than the FP2 UID gives the widest install compatibility.
[0x101F7961],0,0,0,{"Series60ProductID"}
"$BUILD/$NAME.exe"-"!:\\sys\\bin\\$NAME.exe"
EOF
# Extra executables bundled into the same package — a GUI app that ships its own headless
# daemon (USE_SHIM_DAEMON), so one install puts both in \sys\bin and one uninstall removes
# both. Each entry is a path to a built .exe; it installs under its own basename.
for extra in ${EXTRA_EXES:-}; do
  # Relative to the app dir, so app.conf can name a sibling app's build output portably.
  case "$extra" in /*) epath="$extra" ;; *) epath="$APP/$extra" ;; esac
  if [ ! -f "$epath" ]; then
    echo "EXTRA_EXES: $epath not found — build that app first" >&2
    exit 1
  fi
  ebase="$(basename "$epath")"
  echo "\"$epath\"-\"!:\\sys\\bin\\$ebase\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling $ebase"
done
# Polymorphic DLLs bundled into the same package (TARGETTYPE=DLL builds, which
# produce no .sis of their own). They install into \sys\bin alongside the
# executables — that is where RLibrary::Load looks, and on a platform-secured
# device it is the only place it will load code from.
#
# Deliberately separate from EXTRA_EXES rather than folded into it: the two have
# different failure modes. A missing EXE costs the feature it implements; a
# missing DLL that something imports costs the whole image, silently. Naming them
# apart keeps that distinction visible in app.conf.
for extra in ${EXTRA_DLLS:-}; do
  case "$extra" in /*) dpath="$extra" ;; *) dpath="$APP/$extra" ;; esac
  if [ ! -f "$dpath" ]; then
    echo "EXTRA_DLLS: $dpath not found — build that DLL first" >&2
    exit 1
  fi
  dbase="$(basename "$dpath")"
  echo "\"$dpath\"-\"!:\\sys\\bin\\$dbase\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling $dbase"
done
# Arbitrary data files, each written as `<source>:<device path>`.
#
# The general case the EXTRA_* routes above do not cover: they all know where their kind of file
# belongs, and this one is for a file whose destination is the caller's business. The `!:` drive
# prefix is honoured, so `!:\\Data\\x` follows the install drive while `C:\\Data\\x` pins it.
#
# What it is for here: apps/bootctl ships a copy of its compiled start-up resource as plain data,
# so apps/bootd can put it into the Software Installer's import directory itself. The installer is
# supposed to do that at install time and on this handset it does not — see docs/bootmanager.md.
for extra in ${EXTRA_DATA_FILES:-}; do
  dsrc="${extra%%:*}"
  ddst="${extra#*:}"
  if [ "$dsrc" = "$extra" ] || [ -z "$ddst" ]; then
    echo "EXTRA_DATA_FILES: '$extra' is not <source>:<device path>" >&2
    exit 1
  fi
  case "$dsrc" in /*) ;; *) dsrc="$APP/$dsrc" ;; esac
  if [ ! -f "$dsrc" ]; then
    echo "EXTRA_DATA_FILES: $dsrc not found" >&2
    exit 1
  fi
  echo "\"$dsrc\"-\"$ddst\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling data: $(basename "$dsrc") -> $ddst"
done

# Registration and caption resources belonging to a bundled helper app — the companion to
# EXTRA_EXES. EXTRA_EXES copies the executable and nothing else, so a helper app bundled that way
# installs but never appears in the menu (the same silent failure the MTM note below describes).
# Naming its two resources here routes each the way symbuild routes its own: a _reg.rsc to the
# AppArc drop-box so it gets a menu entry, any other .rsc to \resource\apps\ for its caption.
# This is how apps/launcher ships the Kill Home escape hatch inside its own package.
for extra in ${EXTRA_APP_RESOURCES:-}; do
  case "$extra" in /*) rpath="$extra" ;; *) rpath="$APP/$extra" ;; esac
  if [ ! -f "$rpath" ]; then
    echo "EXTRA_APP_RESOURCES: $rpath not found — build that app first" >&2
    exit 1
  fi
  rbase="$(basename "$rpath")"
  case "$rbase" in
    *_reg.rsc) dest="!:\\private\\10003a3f\\import\\apps\\$rbase" ;;
    *)         dest="!:\\resource\\apps\\$rbase" ;;
  esac
  echo "\"$rpath\"-\"$dest\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling app resource $rbase"
done
for rsc in "$BUILD"/*_reg.rsc; do
  [ -f "$rsc" ] || continue
  # The device wants _reg.rsc in the AppArc import drop-box; 10003a3f is the
  # AppArc server's SID, not ours. Getting this path wrong is the classic
  # "installs fine but never appears in the menu" bug.
  echo "\"$rsc\"-\"!:\\private\\10003a3f\\import\\apps\\$(basename "$rsc")\"" >> "$BUILD/$NAME.pkg"
done
for rsc in "$BUILD"/*.rsc; do
  # _reg goes to the AppArc drop-box (above); _startup to the installer's import dir
  # (below). Everything else is a UI resource for \resource\apps\.
  case "$rsc" in *_reg.rsc | *_startup.rsc) continue ;; esac
  [ -f "$rsc" ] || continue
  echo "\"$rsc\"-\"!:\\resource\\apps\\$(basename "$rsc")\"" >> "$BUILD/$NAME.pkg"
done
if [ -n "$ICON_MBM" ]; then
  echo "\"$ICON_MBM\"-\"!:\\resource\\apps\\$(basename "$ICON_MBM")\"" >> "$BUILD/$NAME.pkg"
fi
# The start-up control file must be named [<packageUID>].rsc and land in the Software
# Installer UI's import dir (SID 101f875a). The installer reads it there at install time
# and, for a trusted package, adds the executable to the boot start-up list.
# The MTM registration resource. \resource\messaging\mtm\ is where the Message Server
# looks, and the device dump found that directory empty on C: with 54 files in ROM — so a
# file landing here collides with nothing.
if [ -n "${MTM_RESOURCE:-}" ]; then
  mtmbase="$(basename "$APP/$MTM_RESOURCE" .rss)"
  if [ -f "$BUILD/$mtmbase.mtmrsc" ]; then
    echo "\"$BUILD/$mtmbase.mtmrsc\"-\"!:\\resource\\messaging\\mtm\\$mtmbase.rsc\"" >> "$BUILD/$NAME.pkg"
    echo "--> mtm: $mtmbase.rsc → \\resource\\messaging\\mtm\\"
  fi
fi

# A UI-data component's resource and icons, bundled into this package.
#
# Same reason as EXTRA_MTM_RESOURCES below: the component that builds them is a DLL shipped
# inside somebody else's .sis, and EXTRA_DLLS copies the DLL and nothing else.
for extra in ${EXTRA_MSG_RESOURCES:-}; do
  case "$extra" in /*) rpath="$extra" ;; *) rpath="$APP/$extra" ;; esac
  if [ ! -f "$rpath" ]; then
    echo "EXTRA_MSG_RESOURCES: $rpath not found — build that component first" >&2
    exit 1
  fi
  rbase="$(basename "$rpath")"
  # .uirsc is renamed back to .rsc at the install path; .mbm goes as it is.
  case "$rbase" in
    *.uirsc) dest="${rbase%.uirsc}.rsc" ;;
    *) dest="$rbase" ;;
  esac
  echo "\"$rpath\"-\"!:\\resource\\messaging\\$dest\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling messaging resource $dest"
done

# Registration resources belonging to OTHER components, bundled into this package.
#
# This exists because the obvious arrangement silently does not work, and cost a device trip
# to discover. A probe or an MTM builds its own registration resource through MTM_RESOURCE
# above — and that puts the file in *its own* .sis, which nothing ever installs when the
# binary is shipped inside somebody else's package through EXTRA_EXES. EXTRA_EXES copies the
# executable and nothing else.
#
# So the package that actually gets installed has to name the resource explicitly, the same
# way it already names EXTRA_EXES and EXTRA_DLLS. Each entry is a path to a built .mtmrsc;
# it installs under its own basename with the .rsc extension the Message Server expects.
for extra in ${EXTRA_MTM_RESOURCES:-}; do
  case "$extra" in /*) mpath="$extra" ;; *) mpath="$APP/$extra" ;; esac
  if [ ! -f "$mpath" ]; then
    echo "EXTRA_MTM_RESOURCES: $mpath not found — build that component first" >&2
    exit 1
  fi
  mbase="$(basename "$mpath" .mtmrsc)"
  echo "\"$mpath\"-\"!:\\resource\\messaging\\mtm\\$mbase.rsc\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling mtm registration $mbase.rsc"
done

# An ECom plugin's registration resource, bundled into this package. Same shape as
# EXTRA_MTM_RESOURCES: the plugin DLL is shipped through EXTRA_DLLS, and its REGISTRY_INFO
# resource (built as .ecomrsc by stage 4d in the plugin's own build) is copied here to
# \resource\plugins\, renamed back to .rsc, where ECom reads it.
for extra in ${EXTRA_ECOM_RESOURCES:-}; do
  case "$extra" in /*) epath="$extra" ;; *) epath="$APP/$extra" ;; esac
  if [ ! -f "$epath" ]; then
    echo "EXTRA_ECOM_RESOURCES: $epath not found — build that plugin first" >&2
    exit 1
  fi
  ebase="$(basename "$epath" .ecomrsc)"
  echo "\"$epath\"-\"!:\\resource\\plugins\\$ebase.rsc\"" >> "$BUILD/$NAME.pkg"
  echo "--> bundling ecom registration $ebase.rsc"
done

if [ "${AUTOSTART:-0}" = 1 ] && [ -f "$BUILD/${NAME}_startup.rsc" ]; then
  SUID="${UID3#0x}"; SUID="${SUID^^}"
  echo "\"$BUILD/${NAME}_startup.rsc\"-\"!:\\private\\101f875a\\import\\[$SUID].rsc\"" >> "$BUILD/$NAME.pkg"
  echo "--> autostart: [$SUID].rsc → \\private\\101f875a\\import\\"
fi

# The destination is spelled absolutely, and it has to be.
#
# makesis 4.0 validates it with
#
#     if (wcslen(pszTarget) < (wcslen(DESTFILE) + sizeof(WCHAR))) throw ErrBadTargetFile;
#
# (gnupoc's tools/makesis-4/src/parsecmd.cpp, SetTarget). `DESTFILE` is L".sis", and the
# author meant "at least one character before the extension" — but wrote `sizeof(WCHAR)`
# where they meant `1`. On Windows that is 2 and the threshold is 6; on Linux `wchar_t` is
# four bytes, so anything shorter than **eight characters** is refused as an "invalid
# destination file".
#
# So `makesis cal.pkg cal.sis` fails and `makesis cal.pkg calx.sis` succeeds — an app whose
# name is three characters or fewer could not be packaged at all, and the error names the
# destination without saying what is wrong with it. An absolute path is always long enough,
# and is clearer than a bare name anyway. Patching the tool would work too; this does not
# need every checkout to rebuild it.
( cd "$BUILD" && "$HOST/makesis" "$NAME.pkg" "$BUILD/$NAME.sis" )
OUT="$BUILD/$NAME.sis"

if [ "$SIGN" = 1 ]; then
  KEY="${SIGN_KEY:-$SDK/keys/dev.key}"
  CER="${SIGN_CERT:-$SDK/keys/dev.cer}"
  if [ ! -f "$KEY" ] || [ ! -f "$CER" ]; then
    echo "    minting a 10-year self-signed dev certificate"
    mkdir -p "$(dirname "$KEY")"
    # SHA-1 on purpose: it is what Symbian 9.x verifies.
    openssl req -x509 -newkey rsa:2048 -keyout "$KEY" -out "$CER" \
      -days 3650 -sha1 -nodes -subj "/CN=$VENDOR Dev/O=$VENDOR" 2>/dev/null
  fi
  "$HOST/signsis" "$BUILD/$NAME.sis" "$BUILD/$NAME.sisx" "$CER" "$KEY"
  OUT="$BUILD/$NAME.sisx"
fi

echo
echo "==> $OUT  ($(stat -c%s "$OUT") bytes)"
if [ "$SIGN" = 1 ]; then
  "$HOST/signsis" -o "$OUT" 2>/dev/null | sed 's/^/    /'
else
  echo "    unsigned — needs a patched installserver (Open4All / RomPatcher+)"
fi
echo
echo "Install: copy to the phone, then Menu > Ctrl. panel > App. mgr."
