{
  "llvm-target": "armv5te-none-eabi",
  "data-layout": "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64",
  "arch": "arm",
  "target-endian": "little",
  "target-pointer-width": 32,
  "target-c-int-width": 32,
  "os": "none",
  "env": "eabi",
  "vendor": "symbian",
  "abi": "eabi",
  "llvm-floatabi": "soft",
  "features": "+soft-float,+strict-align",
  "asm-args": ["-mthumb-interwork", "-march=armv5te", "-mlittle-endian"],
  "has-thumb-interworking": true,
  "c-enum-min-bits": 32,
  "max-atomic-width": 0,
  "atomic-cas": false,
  "singlethread": false,
  "panic-strategy": "abort",
  "relocation-model": "static",
  "executables": true,
  "dynamic-linking": false,
  "has-thread-local": false,
  "crt-static-respected": false,
  "crt-objects-fallback": "false",
  "emit-debug-gdb-scripts": false,
  "eh-frame-header": false,
  "function-sections": true,
  "frame-pointer": "may-omit",
  "linker-flavor": "gnu-cc",
  "linker": "arm-none-symbianelf-gcc",
  "linker-is-gnu": true,
  "no-default-libraries": true,
  "main-needs-argc-argv": false,
  "default-visibility": "hidden"
}
